//@version=6
indicator("Macro Analysis", overlay = true, behind_chart = false)

const int SMA_LENGTH = 200
const int MS_PER_DAY = 86400000
const float DAYS_PER_YEAR = 365.25

const color PANEL_BG = #171B23
const color SECTION_BG = #29323F
const color LABEL_COLOR = #C4CEDA
const color VALUE_COLOR = #F2F5F9
const color MUTED_COLOR = #9EAFC2

bool showSma = input.bool(true, "Show SMA 200D")
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
bool supportedChart = isDaily and chart.is_standard
bool confirmedDay = supportedChart and barstate.isconfirmed
float confirmedClose = confirmedDay and math.sign(close) == 1 ? close : na

var float firstClose = na
var int firstDay = na
var float peakClose = na
var float worstDrawdown = na
var int validDays = 0
var int validCloseStreak = 0
var int comparableDays = 0
var int aboveSmaDays = 0

changePercent(float value, float reference) =>
    100 * (value / reference - 1)

if confirmedDay
    validCloseStreak := na(confirmedClose) ? 0 : validCloseStreak + 1
    if not na(confirmedClose)
        if na(firstClose)
            firstClose := confirmedClose
            firstDay := time_tradingday
        validDays += 1
        peakClose := math.max(nz(peakClose, confirmedClose), confirmedClose)
        float drawdown = changePercent(confirmedClose, peakClose)
        worstDrawdown := math.min(nz(worstDrawdown, drawdown), drawdown)

// ta.sma skips na. The streak prevents a window from reaching across an invalid bar.
float rawSma = ta.sma(confirmedClose, SMA_LENGTH)
float dailySma = confirmedDay and validCloseStreak >= SMA_LENGTH ? rawSma : na
if not na(dailySma)
    comparableDays += 1
    if math.sign(confirmedClose - dailySma) == 1
        aboveSmaDays += 1

plot(showSma ? dailySma : na, "SMA 200D", color = #609DB9, style = plot.style_linebr, display = display.pane + display.data_window)

formatPercent(float value) =>
    na(value) ? "N/A" : str.tostring(value, "0.00") + "%"

formatDay(int day) =>
    na(day) ? "N/A" : str.format_time(day, "yyyy-MM-dd", "UTC+0")

formatPeriod(int startDay, int endDay, int days) =>
    string summary = days > 0 ? "Period · " + str.tostring(days, "#,##0") + " days" : "Period"
    string dates = formatDay(endDay)
    if not na(startDay) and not na(endDay) and startDay != endDay
        dates := formatDay(startDay) + " – " + dates
    summary + "\n" + dates

sectionRow(table panel, int row, string heading) =>
    table.cell(panel, 0, row, heading, text_color = VALUE_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = SECTION_BG)

metricRow(table panel, int row, string label, string value, string tooltip) =>
    table.cell(panel, 0, row, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = tooltip)
    table.cell(panel, 1, row, value, text_color = value == "N/A" ? MUTED_COLOR : VALUE_COLOR, text_halign = text.align_right, text_size = size.small)

var table panel = table.new(position.top_right, 2, supportedChart ? 11 : 1, bgcolor = PANEL_BG, frame_color = SECTION_BG, frame_width = 1)
if barstate.isfirst
    table.merge_cells(panel, 0, 0, 1, 0)
    if supportedChart
        table.merge_cells(panel, 0, 3, 1, 3)
        table.merge_cells(panel, 0, 4, 1, 4)
        table.merge_cells(panel, 0, 7, 1, 7)
        table.merge_cells(panel, 0, 10, 1, 10)

if barstate.islast
    if supportedChart
        // The panel stays on the previous confirmed bar throughout the open session.
        int lastDay = barstate.isconfirmed ? time_tradingday : time_tradingday[1]
        float lastClose = barstate.isconfirmed ? confirmedClose : confirmedClose[1]
        float lastSma = barstate.isconfirmed ? dailySma : dailySma[1]

        int days = int((lastDay - firstDay) / MS_PER_DAY)
        float priceRatio = days > 0 and not na(lastClose) ? lastClose / firstClose : na
        float priceReturn = 100 * (priceRatio - 1)
        float cagr = not na(priceRatio) ? 100 * (math.pow(priceRatio, DAYS_PER_YEAR / days) - 1) : na
        float currentDrawdown = changePercent(lastClose, peakClose)
        float maxDrawdown = validDays >= 2 ? worstDrawdown : na
        float smaDistance = changePercent(lastClose, lastSma)
        float shareAbove = comparableDays > 0 ? 100.0 * aboveSmaDays / comparableDays : na
        string aboveText = formatPercent(shareAbove)
        if comparableDays > 0
            aboveText += " · " + str.tostring(comparableDays, "#,##0") + " days"

        sectionRow(panel, 0, "Performance")
        metricRow(panel, 1, "Price Return", formatPercent(priceReturn), "Change in chart price since the first valid close. Dividend treatment depends on the chart's price series.")
        metricRow(panel, 2, "CAGR", formatPercent(cagr), "Annualized price return using calendar days and 365.25 days per year.")
        table.cell(panel, 0, 3, formatPeriod(firstDay, lastDay, days), text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = "First valid close to latest confirmed session. Dates follow the symbol's trading sessions.")
        sectionRow(panel, 4, "Drawdowns")
        metricRow(panel, 5, "Current DD", formatPercent(currentDrawdown), "Latest confirmed close relative to the highest observed close.")
        metricRow(panel, 6, "Max DD", formatPercent(maxDrawdown), "Lowest observed drawdown over the loaded history.")
        sectionRow(panel, 7, "MA Behavior")
        metricRow(panel, 8, "Distance to SMA 200D", formatPercent(smaDistance), "Latest confirmed close relative to its SMA of 200 consecutive valid chart closes.")
        metricRow(panel, 9, "Days Above SMA", aboveText, "Share of comparable days strictly above their SMA 200D. The count includes all comparable days, including closes at their SMA.")

        string coverage = "History loaded by TradingView"
        if not na(lastDay) and na(lastClose)
            coverage += " · Latest close unavailable"
        table.cell(panel, 0, 10, coverage, text_color = MUTED_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = "The first loaded bar can be later than the first trading day. Missing bars may limit coverage.")
    else
        string instruction = isDaily ? "Use a standard price chart" : "Use a 1D chart"
        sectionRow(panel, 0, "Macro Analysis · " + instruction)
