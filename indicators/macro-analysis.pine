//@version=6
indicator("Macro Analysis", overlay = true, behind_chart = false)

const int MS_PER_DAY = 86400000
const float DAYS_PER_YEAR = 365.25
// Ten calendar years contain at most 3,653 daily sessions. Keep room for the
// predecessor of the oldest target even when there are no sessions near it.
const int PERIOD_HISTORY_SIZE = 4096
const string SESSION_ZONE = "UTC+0"
const int OPPORTUNITY_LAG_DAYS = 4

const color PANEL_BG = #171B23
const color SECTION_BG = #29323F
const color LABEL_COLOR = #C4CEDA
const color VALUE_COLOR = #F2F5F9
const color MUTED_COLOR = #9EAFC2
const color BEST_COLOR = #82D6A9
const color LOW_COLOR = #F3A0A0
const color EXTREME_ABOVE_COLOR = #D75567
const color EXTREME_BELOW_COLOR = #30AE91
const int MIN_MA_SESSIONS = 20
const int MIN_MA_DISTANCES = 30
const int MIN_MA_RUNS = 10

int smaLength = input.int(200, "SMA", minval = 2, inline = "sma")
string smaTimeframe = input.string("Daily", "", options = ["Daily", "Weekly", "Monthly"], inline = "sma")
bool showSma = input.bool(true, "", inline = "sma", tooltip = "Length, timeframe, and whether to show the SMA line.")
bool smoothSma = input.bool(false, "Smooth SMA", active = smaTimeframe != "Daily", tooltip = "Moves gradually to the next confirmed weekly or monthly SMA.")
string panelCorner = input.string("Top right", "Panel corner", options = ["Top right", "Top left", "Bottom right", "Bottom left"])
string panelView = input.string("Overview", "Panel View", options = ["Overview", "Dips", "Compare", "MA Behavior"])
bool showDips = panelView == "Dips"
bool showCompare = panelView == "Compare"
bool showMaBehavior = panelView == "MA Behavior"
bool colorExtremeCandles = input.bool(false, "Color Extreme Candles")
int maExtremePercentile = input.int(95, "Extreme Percentile", minval = 55, maxval = 100, active = showCompare or showMaBehavior or colorExtremeCandles, tooltip = "Upper percentile of signed daily distances. The lower threshold uses the complementary percentile. A new event requires leaving the zone.")
string maStatisticsPeriod = input.string("5 Years", "MA Statistics Period", options = ["5 Years", "10 Years", "All Available"], active = showCompare or showMaBehavior or colorExtremeCandles)
bool compareInSEK = input.string("SEK", "Compare currency", options = ["SEK", "Native"], active = showCompare) == "SEK"
float dipFirst = input.float(5, "Dip thresholds (%)", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipSecond = input.float(10, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipThird = input.float(20, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipFourth = input.float(30, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips, tooltip = "Enter four thresholds in strictly increasing order.")
float reversal = input.float(5, "Reversal %", minval = 0.01, active = showDips or showCompare)
bool includeA = input.bool(true, "Symbol 1", inline = "compareA", active = showCompare)
string symbolA = input.symbol("BATS:ACWI", "", inline = "compareA", active = showCompare and includeA)
bool includeB = input.bool(true, "Symbol 2", inline = "compareB", active = showCompare)
string symbolB = input.symbol("XETR:EUNL", "", inline = "compareB", active = showCompare and includeB)
bool includeC = input.bool(true, "Symbol 3", inline = "compareC", active = showCompare)
string symbolC = input.symbol("XETR:VWCE", "", inline = "compareC", active = showCompare and includeC)
bool includeD = input.bool(true, "Symbol 4", inline = "compareD", active = showCompare)
string symbolD = input.symbol("OMXSTO:XACTHDIV", "", inline = "compareD", active = showCompare and includeD)
bool orderedThresholds = dipFirst < dipSecond and dipSecond < dipThird and dipThird < dipFourth
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
bool supportedChart = isDaily and chart.is_standard
bool supportedMaChart = chart.is_standard and (timeframe.isseconds or timeframe.isminutes or timeframe.isdwm)
bool confirmedDay = supportedChart and barstate.isconfirmed
bool comparisonPanel = supportedChart and showCompare

validPrice(float price) =>
    math.sign(price) == 1 ? price : na

priceInCompareCurrency(float price, string quoteCurrency, bool useSEK) =>
    float converted = price
    if useSEK and (na(quoteCurrency) or quoteCurrency == "")
        converted := na
    else if useSEK and quoteCurrency != currency.SEK
        // Request the raw close in SEK inside this symbol's own daily context.
        converted := request.security(syminfo.tickerid, "1D", close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true, currency = currency.SEK)
    validPrice(converted)

float confirmedClose = confirmedDay ? validPrice(close) : na
float comparisonClose = comparisonPanel ? priceInCompareCurrency(close, syminfo.currency, compareInSEK) : na
bool comparisonFxMissing = comparisonPanel and not na(validPrice(close)) and na(comparisonClose)

var int comparableDays = 0
var int aboveSmaDays = 0

changePercent(float value, float reference) =>
    100 * (value / reference - 1)

type PriceHistory
    array<int> sessionDays
    array<float> sessionCloses
    array<float> sessionDrawdowns
    int sessionCount = 0
    float firstClose = na
    int firstDay = na
    float peakClose = na
    float worstDrawdown = na
    int validDays = 0
    int lastDay = na
    float lastClose = na
    bool missingFx = false

newPriceHistory() =>
    PriceHistory.new(array.new<int>(PERIOD_HISTORY_SIZE), array.new<float>(PERIOD_HISTORY_SIZE), array.new<float>(showCompare ? PERIOD_HISTORY_SIZE : 0))

method addClose(PriceHistory history, int day, float price) =>
    int slot = history.sessionCount % PERIOD_HISTORY_SIZE
    history.sessionDays.set(slot, day)
    history.sessionCloses.set(slot, price)
    history.sessionCount += 1
    history.lastDay := day
    history.lastClose := price
    float drawdown = na
    if not na(price)
        if na(history.firstClose)
            history.firstClose := price
            history.firstDay := day
        history.validDays += 1
        history.peakClose := math.max(nz(history.peakClose, price), price)
        drawdown := changePercent(price, history.peakClose)
        history.worstDrawdown := math.min(nz(history.worstDrawdown, drawdown), drawdown)
    if showCompare
        history.sessionDrawdowns.set(slot, drawdown)

priceRatio(PriceHistory history) =>
    history.lastDay > history.firstDay ? history.lastClose / history.firstClose : na

annualizedReturn(PriceHistory history) =>
    int days = int((history.lastDay - history.firstDay) / MS_PER_DAY)
    float ratio = priceRatio(history)
    not na(ratio) ? 100 * (math.pow(ratio, DAYS_PER_YEAR / days) - 1) : na

maximumDrawdown(PriceHistory history) =>
    history.validDays >= 2 ? history.worstDrawdown : na

advanceDip(float top, float bottom, float price, float reversalPct) =>
    float nextTop = top
    float nextBottom = bottom
    float depth = na
    if na(price)
        nextTop := na
        nextBottom := na
    else if na(top)
        nextTop := price
    else if na(bottom)
        if math.sign(price - top) < 0
            nextBottom := price
        else
            nextTop := price
    else
        nextBottom := math.min(bottom, price)
        if math.sign(price - top) >= 0 or changePercent(price, nextBottom) >= reversalPct
            depth := -changePercent(nextBottom, top)
            nextTop := price
            nextBottom := na
    [nextTop, nextBottom, depth]

type DipHistory
    array<int> counts
    float top = na
    float bottom = na
    int previousValidDay = na
    int observedDays = 0
    int invalidBars = 0
    int interrupted = 0

method addDipClose(DipHistory history, int day, float price, float reversalPct, array<float> thresholds, bool countDips) =>
    if na(price)
        history.invalidBars += 1
        if not na(history.bottom)
            history.interrupted += 1
        history.previousValidDay := na
    else
        if not na(history.previousValidDay)
            history.observedDays += int((day - history.previousValidDay) / MS_PER_DAY)
        history.previousValidDay := day
    [nextTop, nextBottom, closedDepth] = advanceDip(history.top, history.bottom, price, reversalPct)
    history.top := nextTop
    history.bottom := nextBottom
    if countDips and not na(closedDepth)
        for [index, threshold] in thresholds
            if closedDepth >= threshold
                history.counts.set(index, history.counts.get(index) + 1)

var PriceHistory chartPrices = newPriceHistory()
var array<float> thresholds = showCompare ? array.from(10.0) : array.from(dipFirst, dipSecond, dipThird, dipFourth)
var DipHistory chartDips = DipHistory.new(array.new<int>(thresholds.size(), 0))

if confirmedDay
    float metricClose = showCompare ? comparisonClose : confirmedClose
    chartPrices.addClose(time_tradingday, metricClose)
    chartPrices.missingFx := chartPrices.missingFx or comparisonFxMissing
    if showDips or showCompare
        chartDips.addDipClose(time_tradingday, metricClose, reversal, thresholds, showCompare or orderedThresholds)

consecutiveSma(float price, int length) =>
    // ta.sma skips na. The streak prevents its window from crossing an invalid bar.
    var int streak = 0
    streak := na(price) ? 0 : streak + 1
    float mean = ta.sma(price, length)
    streak >= length ? mean : na

completedSmas(int length) =>
    float mean = consecutiveSma(validPrice(close), length)
    [nz(mean[1]), nz(mean[2])]

smoothCompletedSma(float mean, float earlier, string period) =>
    float result = mean
    if smoothSma and not na(mean) and math.sign(earlier) == 1
        int periodStart = time(period)
        int periodEnd = time_close(period)
        if periodEnd > periodStart
            float progress = math.max(0.0, math.min(1.0, float(time_close - periodStart) / (periodEnd - periodStart)))
            result := earlier + progress * (mean - earlier)
    result

maForDailyClose(float dailyClose) =>
    float mean = consecutiveSma(dailyClose, smaLength)
    if smaTimeframe != "Daily"
        string requestedTimeframe = smaTimeframe == "Weekly" ? "1W" : "1M"
        // Compute in the daily context even when the chart itself is weekly or monthly.
        [completedSma, earlierSma] = request.security(syminfo.tickerid, requestedTimeframe, completedSmas(smaLength), lookahead = barmerge.lookahead_on)
        mean := smoothCompletedSma(validPrice(completedSma), earlierSma, requestedTimeframe)
    mean

compareSma(float price, bool converted) =>
    if not converted or smaTimeframe == "Daily"
        maForDailyClose(price)
    else
        string period = smaTimeframe == "Weekly" ? "1W" : "1M"
        bool newPeriod = timeframe.change(period) and not na(time(period)[1])
        // Take the already converted last daily close only after its period ends.
        float periodClose = newPeriod ? price[1] : na
        float average = ta.sma(periodClose, smaLength)
        var int streak = 0
        var float mean = na
        var float earlier = na
        if newPeriod
            streak := na(periodClose) ? 0 : streak + 1
            earlier := mean
            mean := streak >= smaLength ? average : na
        smoothCompletedSma(mean, earlier, period)

float smaForDay = supportedChart ? maForDailyClose(confirmedClose) : na

if not na(confirmedClose) and not na(smaForDay)
    comparableDays += 1
    if math.sign(confirmedClose - smaForDay) == 1
        aboveSmaDays += 1

yearsEarlier(int sessionDay, int yearsBack) =>
    int targetYear = year(sessionDay, SESSION_ZONE) - yearsBack
    int targetMonth = month(sessionDay, SESSION_ZONE)
    int targetDay = dayofmonth(sessionDay, SESSION_ZONE)
    bool leapYear = targetYear % 4 == 0 and (targetYear % 100 != 0 or targetYear % 400 == 0)
    if targetMonth == 2 and targetDay == 29 and not leapYear
        targetDay := 28
    timestamp(SESSION_ZONE, targetYear, targetMonth, targetDay, 0, 0)

type MaSample
    int day
    float value

type MaDistribution
    array<float> ordered
    array<MaSample> byDate

newMaDistribution() =>
    MaDistribution.new(array.new<float>(), array.new<MaSample>())

distanceBound(array<float> ordered, float value, bool inclusive) =>
    int first = 0
    int last = ordered.size()
    while first < last
        int mid = first + int((last - first) / 2)
        float direction = math.sign(ordered.get(mid) - value)
        if direction < 0 or (inclusive and direction == 0)
            first := mid + 1
        else
            last := mid
    first

upperBound(array<float> ordered, float value) =>
    distanceBound(ordered, value, true)

method includeSample(MaDistribution distribution, int day, float value, bool keepDates) =>
    int position = upperBound(distribution.ordered, value)
    if position == distribution.ordered.size()
        distribution.ordered.push(value)
    else
        distribution.ordered.insert(position, value)
    if keepDates
        distribution.byDate.push(MaSample.new(day, value))

method expireSamples(MaDistribution distribution, int cutoff) =>
    while distribution.byDate.size() > 0 and distribution.byDate.first().day < cutoff
        MaSample sample = distribution.byDate.shift()
        distribution.ordered.remove(distribution.ordered.binary_search(sample.value))

method maPercentile(MaDistribution distribution, int percentile, int minimum) =>
    int size = distribution.ordered.size()
    size >= minimum ? distribution.ordered.get(int(math.ceil(size * percentile / 100.0)) - 1) : na

method maMedian(MaDistribution distribution, int minimum) =>
    int size = distribution.ordered.size()
    size >= minimum ? (distribution.ordered.get(int((size - 1) / 2)) + distribution.ordered.get(int(size / 2))) / 2 : na

type MaHistory
    MaDistribution aboveDistances
    MaDistribution belowDistances
    MaDistribution aboveRuns
    MaDistribution belowRuns
    array<int> equalDays
    int equalCount = 0
    int firstComparable = na
    int lastDay = na
    int cutoff = na
    bool previousComparable = false
    int side = 0
    int runStart = na
    int runLength = 0
    bool runStartKnown = false
    float distance = na
    float stretch = na
    int extremeZone = 0

newMaHistory() =>
    MaHistory.new(newMaDistribution(), newMaDistribution(), newMaDistribution(), newMaDistribution(), array.new<int>())

method coversWindow(MaHistory history, int cutoff) =>
    not na(history.firstComparable) and (na(cutoff) or history.firstComparable <= cutoff)

method signedDistanceAt(MaHistory history, int index) =>
    int below = history.belowDistances.ordered.size()
    int nonpositive = below + history.equalCount
    index < below ? -history.belowDistances.ordered.get(below - index - 1) : index < nonpositive ? 0.0 : history.aboveDistances.ordered.get(index - nonpositive)

percentilePosition(int count, int percentile) =>
    (count - 1) * percentile / 100.0

method signedPercentile(MaHistory history, int percentile) =>
    int count = history.aboveDistances.ordered.size() + history.belowDistances.ordered.size() + history.equalCount
    float position = percentilePosition(count, percentile)
    int left = int(math.floor(position))
    float lower = history.signedDistanceAt(left)
    float upper = history.signedDistanceAt(int(math.ceil(position)))
    lower + (upper - lower) * (position - left)

method recordExtremeEntry(MaHistory history, int side, float distance, int cutoff, int percentile) =>
    int event = 0
    int zone = history.extremeZone
    bool covered = history.coversWindow(cutoff)
    bool aboveReady = covered and history.aboveDistances.ordered.size() >= MIN_MA_DISTANCES
    bool belowReady = covered and history.belowDistances.ordered.size() >= MIN_MA_DISTANCES
    int lowerTail = 100 - percentile
    if zone == 1 and (side <= 0 or (aboveReady and distance < history.signedPercentile(percentile - 5)))
        zone := 0
    else if zone == -1 and (side >= 0 or (belowReady and distance > history.signedPercentile(lowerTail + 5)))
        zone := 0
    if zone == 0
        if side > 0 and aboveReady and distance >= history.signedPercentile(percentile)
            event := 1
        else if side < 0 and belowReady and distance <= history.signedPercentile(lowerTail)
            event := -1
        zone := event
    history.extremeZone := zone
    event

method observeMa(MaHistory history, int day, float price, float mean, int years, int percentile, bool assess, bool showStretch) =>
    int cutoff = years > 0 ? yearsEarlier(day, years) : na
    bool keepDates = not na(cutoff)
    if keepDates
        history.aboveDistances.expireSamples(cutoff)
        history.belowDistances.expireSamples(cutoff)
        history.aboveRuns.expireSamples(cutoff)
        history.belowRuns.expireSamples(cutoff)
        while history.equalDays.size() > 0 and history.equalDays.first() < cutoff
            history.equalDays.shift()
            history.equalCount -= 1

    bool comparable = not na(price) and not na(mean)
    int side = comparable ? int(math.sign(price - mean)) : 0
    float magnitude = comparable ? 100 * math.abs(price - mean) / mean : na
    int length = side == 0 ? 0 : side == history.side ? history.runLength + 1 : 1
    MaDistribution distances = side > 0 ? history.aboveDistances : history.belowDistances
    // Score against prior distances. A missing observation cannot rearm a zone.
    int event = assess and comparable ? history.recordExtremeEntry(side, side * magnitude, cutoff, percentile) : 0
    history.stretch := showStretch and side != 0 and history.coversWindow(cutoff) and distances.ordered.size() >= MIN_MA_DISTANCES ? 100.0 * upperBound(distances.ordered, magnitude) / distances.ordered.size() : na

    if side != history.side
        if comparable and history.runStartKnown and (not keepDates or history.runStart >= cutoff)
            MaDistribution closedRuns = history.side > 0 ? history.aboveRuns : history.belowRuns
            closedRuns.includeSample(history.runStart, history.runLength, keepDates)
        history.runStart := side == 0 ? na : day
        history.runStartKnown := side != 0 and history.previousComparable

    if comparable
        if na(history.firstComparable)
            history.firstComparable := day
        if side == 0
            history.equalCount += 1
            if keepDates
                history.equalDays.push(day)
        else
            distances.includeSample(day, magnitude, keepDates)
    history.lastDay := day
    history.cutoff := cutoff
    history.previousComparable := comparable
    history.side := side
    history.runLength := length
    history.distance := side * magnitude
    event

bool maBehaviorPanel = supportedMaChart and showMaBehavior
bool trackMaBehavior = supportedMaChart and (showMaBehavior or colorExtremeCandles)
int maYears = maStatisticsPeriod == "5 Years" ? 5 : maStatisticsPeriod == "10 Years" ? 10 : 0

type MaSideSummary
    int sessions
    int runs
    float medianDistance
    float p90Distance
    float medianDuration
    float p90Duration

summarizeMaSide(MaDistribution distances, MaDistribution runs, bool covered) =>
    MaSideSummary.new(distances.ordered.size(), runs.ordered.size(), covered ? distances.maMedian(MIN_MA_DISTANCES) : na,
         covered ? distances.maPercentile(90, MIN_MA_DISTANCES) : na, covered ? runs.maMedian(MIN_MA_RUNS) : na, covered ? runs.maPercentile(90, MIN_MA_RUNS) : na)

type MaSummary
    MaSideSummary above
    MaSideSummary below
    int equalCount
    bool covered
    int startDay
    int endDay
    bool comparable
    int side
    int runLength
    bool runStartKnown
    float distance
    float stretch
    int event

method summarizeMa(MaHistory history, int event) =>
    bool covered = history.coversWindow(history.cutoff)
    int start = math.max(nz(history.cutoff, history.firstComparable), history.firstComparable)
    MaSummary.new(summarizeMaSide(history.aboveDistances, history.aboveRuns, covered), summarizeMaSide(history.belowDistances, history.belowRuns, covered),
         history.equalCount, covered, start, history.lastDay, history.previousComparable, history.side, history.runLength, history.runStartKnown, history.distance, history.stretch, event)

type DailyMaFrame
    int closesAt
    float finalPrice
    float mean
    bool sourceHistorical
    int eventAt
    int eventSide
    MaSummary summary

dailyMaFrame(float price, float mean, bool takeClose) =>
    var MaHistory history = trackMaBehavior ? newMaHistory() : na
    var DailyMaFrame frame = na
    var int eventAt = na
    var int eventSide = 0
    if takeClose
        int event = trackMaBehavior ? history.observeMa(time_tradingday, price, mean, maYears, maExtremePercentile, true, showMaBehavior) : 0
        if event != 0
            eventAt := time_close
            eventSide := event
        frame := DailyMaFrame.new(time_close, price, mean, barstate.ishistory, eventAt, eventSide, showMaBehavior ? history.summarizeMa(event) : na)
    frame

requestedDailyMa() =>
    float price = validPrice(close)
    DailyMaFrame frame = dailyMaFrame(price, maForDailyClose(price), true)
    // Only scalar results leave the daily context. The previous frame is final
    // even when the current source bar is still developing.
    [frame, frame[1]]

confirmedMaFrame(DailyMaFrame source, DailyMaFrame previous) =>
    int availableUntil = barstate.ishistory ? time_close : math.min(time_close, timenow)
    bool sourceElapsed = not na(source) and source.closesAt <= availableUntil
    // A simultaneous host close corroborates the daily close on the same feed.
    bool sameClose = sourceElapsed and barstate.isconfirmed and source.closesAt == time_close and math.sign(source.finalPrice - close) == 0
    sourceElapsed and (barstate.ishistory or source.sourceHistorical or sameClose) ? source : not na(previous) and previous.closesAt <= availableUntil ? previous : na

DailyMaFrame activeMa = na
if supportedChart
    activeMa := dailyMaFrame(confirmedClose, smaForDay, confirmedDay)
else if supportedMaChart and (showSma or trackMaBehavior)
    [source, previous] = request.security(syminfo.tickerid, "1D", requestedDailyMa(), lookahead = barmerge.lookahead_off)
    activeMa := confirmedMaFrame(source, previous)

float chartMa = na(activeMa) ? na : activeMa.mean
int confirmedThrough = na(activeMa) ? na : activeMa.closesAt
int eventAt = na(activeMa) ? na : activeMa.eventAt
bool eventInsideBar = not na(eventAt) and eventAt > time and eventAt <= time_close
bool eventPublishedLate = timeframe.isintraday and not na(confirmedThrough[1]) and not na(eventAt) and eventAt > confirmedThrough[1] and eventAt <= time
color extremeCandle = colorExtremeCandles and (eventInsideBar or eventPublishedLate) ? (activeMa.eventSide > 0 ? EXTREME_ABOVE_COLOR : EXTREME_BELOW_COLOR) : na
plot(showSma ? chartMa : na, "SMA", color = #609DB9, style = plot.style_linebr, display = display.pane + display.data_window)
// Draw only the flagged candles, at the chart's own OHLC coordinates.
plotcandle(not na(extremeCandle) ? open : na, high, low, close, "Extreme MA Candles", color = extremeCandle, wickcolor = extremeCandle, bordercolor = extremeCandle, editable = false, display = display.pane)

referenceIndex(PriceHistory history, int target) =>
    int oldest = math.max(0, history.sessionCount - PERIOD_HISTORY_SIZE)
    int startIndex = oldest
    int endIndex = history.sessionCount
    // Search by chronological index and use modulo only when accessing storage.
    while startIndex < endIndex
        int mid = startIndex + int((endIndex - startIndex) / 2)
        if history.sessionDays.get(mid % PERIOD_HISTORY_SIZE) <= target
            startIndex := mid + 1
        else
            endIndex := mid
    startIndex > oldest ? startIndex - 1 : na

referenceAt(PriceHistory history, int target) =>
    int slot = referenceIndex(history, target) % PERIOD_HISTORY_SIZE
    // Keep invalid bars in the search so an unknown reference cannot be skipped.
    [na(slot) ? na : history.sessionDays.get(slot), na(slot) ? na : history.sessionCloses.get(slot)]

formatPercent(float value) =>
    na(value) ? "N/A" : str.tostring(value, "0.00") + "%"

formatDay(int day) =>
    na(day) ? "N/A" : str.format_time(day, "yyyy-MM-dd", SESSION_ZONE)

formatPeriod(int startDay, int endDay) =>
    not na(startDay) and startDay != endDay ? formatDay(startDay) + " – " + formatDay(endDay) : formatDay(endDay)

band(table panel, int row, string heading, string tooltip = "") =>
    table.cell(panel, 0, row, heading, text_color = VALUE_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = SECTION_BG, tooltip = tooltip)

metricText(table panel, int column, int row, string label, string value, string tooltip) =>
    table.cell(panel, column, row, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = tooltip)
    table.cell(panel, column + 1, row, value, text_color = value == "N/A" ? MUTED_COLOR : VALUE_COLOR, text_halign = text.align_right, text_size = size.small, tooltip = tooltip)

metric(table panel, int column, int row, string label, float value, string tooltip) =>
    metricText(panel, column, row, label, formatPercent(value), tooltip)

periodMetric(table panel, int column, int row, int yearsBack, int endDay, float endClose, PriceHistory history) =>
    int target = na(endDay) ? na : yearsEarlier(endDay, yearsBack)
    [refDay, refClose] = referenceAt(history, target)
    string detail = na(refDay) ? "Insufficient loaded history." : na(refClose) ? "Invalid reference close on " + formatDay(refDay) + "." : "From " + formatDay(refDay) + " to " + formatDay(endDay) + "."
    if na(endClose) and not na(refClose)
        detail += " Latest confirmed close unavailable."
    metric(panel, column, row, str.tostring(yearsBack) + "Y", changePercent(endClose, refClose), detail)

dipRates(int count, int observedDays, int startDay) =>
    // An anniversary can be 365 or 366 days away. Use the same calendar
    // convention as period returns and require that many covered days.
    int yearDays = na(startDay) ? na : int((yearsEarlier(startDay, -1) - startDay) / MS_PER_DAY)
    bool enoughHistory = not na(yearDays) and observedDays >= yearDays
    float observedYears = observedDays / DAYS_PER_YEAR
    float perYear = enoughHistory ? count / observedYears : na
    float yearsPerDip = enoughHistory and count > 0 ? observedYears / count : na
    [perYear, yearsPerDip]

dipFrequencyText(int count, float perYear, float yearsPerDip) =>
    na(perYear) ? "N/A" : count == 0 ? "0" : perYear >= 1 ? str.tostring(perYear, "0.0") + "/y" : "1/" + str.tostring(yearsPerDip, "0.0") + "y"

dipMetric(table panel, int row, float threshold, int count, int observedDays, int startDay, string coverage) =>
    [perYear, yearsPerDip] = dipRates(count, observedDays, startDay)
    string detail = str.tostring(count) + " completed dips at or above this threshold."
    detail += "\n" + coverage
    if na(perYear)
        detail += "\nAt least one calendar year of observed coverage is required for annualized rates."
    else
        detail += "\nPer year: " + str.tostring(perYear, "0.00")
        if count > 0
            detail += " · Years per dip: " + str.tostring(yearsPerDip, "0.00")
    detail += "\nObserved frequency."
    metricText(panel, 0, row, "≥" + str.tostring(threshold) + "%", dipFrequencyText(count, perYear, yearsPerDip), detail)

// A shared calendar target stays constant throughout historical execution.
// Keep its predecessor as bars arrive and re-search only if the target moves.
referenceForAnchor(PriceHistory history, int target) =>
    var int cachedTarget = na
    var int referenceDay = na
    var float referenceClose = na
    if na(cachedTarget) or target != cachedTarget
        [day, price] = referenceAt(history, target)
        referenceDay := day
        referenceClose := price
        cachedTarget := target
    else if not na(history.lastDay) and history.lastDay <= target
        referenceDay := history.lastDay
        referenceClose := history.lastClose
    [referenceDay, referenceClose]

int comparisonAnchor = int(timenow / MS_PER_DAY) * MS_PER_DAY
int oneYearTarget = yearsEarlier(comparisonAnchor, 1)
int threeYearTarget = yearsEarlier(comparisonAnchor, 3)
int fiveYearTarget = yearsEarlier(comparisonAnchor, 5)

periodCagr(int start, float initial, int finish, float finalPrice) =>
    float years = (finish - start) / MS_PER_DAY / DAYS_PER_YEAR
    years > 0 ? 100 * (math.pow(finalPrice / initial, 1.0 / years) - 1) : na

opportunityIndex(float quality, float currentDD) =>
    float discount = -currentDD
    quality > 0 and discount > 0 and discount < 100 ? quality * discount / (100 - discount) : na

type ComparisonSnapshot
    int cutoff
    int endDay
    int ref3
    int ref5
    float quality
    float drawdown
    float score
    int rarityCount
    int rarityDays

recentSession(int day, int target) =>
    not na(day) and day <= target and day >= target - OPPORTUNITY_LAG_DAYS * MS_PER_DAY

type MaComparison
    int day
    float distance
    float percentile = na
    int extreme = 0
    int firstPriorDay = na
    int lastPriorDay = na
    int priorCount = 0
    int sideCount = 0
    bool covered = false

type CompareMaHistory
    array<int> days
    array<float> distances
    array<MaComparison> recent

newCompareMaHistory() =>
    CompareMaHistory.new(array.new<int>(), array.new<float>(), array.new<MaComparison>())

sortedPercentile(array<float> ordered, int percentile) =>
    float position = percentilePosition(ordered.size(), percentile)
    int left = int(math.floor(position))
    float lower = ordered.get(left)
    lower + (ordered.get(int(math.ceil(position))) - lower) * (position - left)

signedPercentileRank(array<float> ordered, float distance) =>
    int left = distanceBound(ordered, distance, false)
    int right = upperBound(ordered, distance)
    float position = 0.0
    if left < right
        position := (left + right - 1) / 2.0
    else if left == ordered.size()
        position := left - 1
    else if left > 0
        float lower = ordered.get(left - 1)
        position := left - 1 + (distance - lower) / (ordered.get(left) - lower)
    100.0 * position / (ordered.size() - 1)

method addMaClose(CompareMaHistory history, int day, float price, float mean) =>
    float distance = 100 * (price - mean) / mean
    if recentSession(day, comparisonAnchor)
        MaComparison snapshot = MaComparison.new(day, distance)
        int count = history.days.size()
        int cutoff = maYears > 0 ? yearsEarlier(day, maYears) : na
        if count > 0
            int first = history.days.first()
            snapshot.covered := na(cutoff) or first <= cutoff
            int index = na(cutoff) or first >= cutoff ? 0 : history.days.last() < cutoff ? count : history.days.binary_search_rightmost(cutoff)
            snapshot.priorCount := count - index
            if snapshot.priorCount > 0
                snapshot.firstPriorDay := history.days.get(index)
                snapshot.lastPriorDay := history.days.last()
            // Sort a copy only for recent endpoints, before adding today's close.
            if snapshot.covered and snapshot.priorCount >= MIN_MA_DISTANCES and not na(distance)
                array<float> sorted = history.distances.slice(index, count).copy()
                sorted.sort()
                int side = int(math.sign(distance))
                snapshot.sideCount := side > 0 ? sorted.size() - upperBound(sorted, 0.0) : side < 0 ? distanceBound(sorted, 0.0, false) : sorted.size()
                if snapshot.sideCount >= MIN_MA_DISTANCES
                    snapshot.percentile := signedPercentileRank(sorted, distance)
                    if side > 0 and distance >= sortedPercentile(sorted, maExtremePercentile)
                        snapshot.extreme := 1
                    else if side < 0 and distance <= sortedPercentile(sorted, 100 - maExtremePercentile)
                        snapshot.extreme := -1
        if history.recent.size() == OPPORTUNITY_LAG_DAYS + 1
            history.recent.shift()
        history.recent.push(snapshot)
    if not na(distance)
        history.days.push(day)
        history.distances.push(distance)

dipRarityCounts(PriceHistory prices, int startIndex, int endIndex, float cutoffDrawdown) =>
    int deep = 0
    int days = endIndex - startIndex + 1
    for index = startIndex to endIndex
        float drawdown = prices.sessionDrawdowns.get(index % PERIOD_HISTORY_SIZE)
        if na(drawdown)
            // An explicit invalid bar leaves the five-year distribution uncertain.
            days := na
            deep := na
            break
        if drawdown <= cutoffDrawdown
            deep += 1
    [deep, days]

comparisonAt(PriceHistory prices, int cutoff) =>
    ComparisonSnapshot snapshot = na
    int endIndex = referenceIndex(prices, cutoff)
    if not na(endIndex)
        int endSlot = endIndex % PERIOD_HISTORY_SIZE
        int endDay = prices.sessionDays.get(endSlot)
        float endPrice = prices.sessionCloses.get(endSlot)
        if recentSession(endDay, cutoff) and not na(endPrice)
            int target3 = yearsEarlier(cutoff, 3)
            int target5 = yearsEarlier(cutoff, 5)
            [ref3, price3] = referenceAt(prices, target3)
            int ref5Index = referenceIndex(prices, target5)
            if not na(ref5Index)
                int ref5Slot = ref5Index % PERIOD_HISTORY_SIZE
                int ref5 = prices.sessionDays.get(ref5Slot)
                float price5 = prices.sessionCloses.get(ref5Slot)
                if recentSession(ref5, target5) and not na(price5)
                    float drawdown = prices.sessionDrawdowns.get(endSlot)
                    float quality = recentSession(ref3, target3) ? 0.7 * periodCagr(ref3, price3, endDay, endPrice) + 0.3 * periodCagr(ref5, price5, endDay, endPrice) : na
                    float score = opportunityIndex(quality, drawdown)
                    // The predecessor verifies the boundary. Count it only when it is in the window.
                    int startIndex = ref5 == target5 ? ref5Index : ref5Index + 1
                    [deep, days] = dipRarityCounts(prices, startIndex, endIndex, drawdown)
                    if not na(score) or not na(days)
                        snapshot := ComparisonSnapshot.new(cutoff, endDay, ref3, ref5, quality, drawdown, score, deep, days)
    snapshot

recentComparisons(PriceHistory prices, int anchor) =>
    array<ComparisonSnapshot> snapshots = na
    if recentSession(prices.lastDay, anchor) and not prices.missingFx
        snapshots := array.new<ComparisonSnapshot>()
        // Transfer only this bounded set, and only near the latest session.
        for offset = 0 to OPPORTUNITY_LAG_DAYS
            int cutoff = anchor - offset * MS_PER_DAY
            if cutoff <= prices.lastDay
                ComparisonSnapshot snapshot = comparisonAt(prices, cutoff)
                if not na(snapshot) and recentSession(snapshot.endDay, anchor)
                    snapshots.push(snapshot)
    snapshots

comparisonMetrics(PriceHistory prices, DipHistory dips, CompareMaHistory ma, int oneYear, int threeYears, int fiveYears, bool useSEK) =>
    [ref1, close1] = referenceForAnchor(prices, oneYear)
    [ref3, close3] = referenceForAnchor(prices, threeYears)
    [ref5, close5] = referenceForAnchor(prices, fiveYears)
    int count = dips.counts.get(0)
    [rate, interval] = dipRates(count, dips.observedDays, prices.firstDay)
    bool history3 = prices.lastDay > threeYears
    bool history5 = prices.lastDay > fiveYears
    // Price and dip histories stay in their own context.
    [useSEK ? currency.SEK : syminfo.currency, prices.firstDay, prices.lastDay, ref1, ref3, ref5,
     count, dips.observedDays, dips.invalidBars, prices.missingFx,
     annualizedReturn(prices), prices.lastDay > oneYear ? changePercent(prices.lastClose, close1) : na,
     history3 ? changePercent(prices.lastClose, close3) : na, history5 ? changePercent(prices.lastClose, close5) : na,
     changePercent(prices.lastClose, prices.peakClose), maximumDrawdown(prices), changePercent(prices.lastClose, dips.top), rate, interval,
     history3 ? periodCagr(ref3, close3, prices.lastDay, prices.lastClose) : na,
     history5 ? periodCagr(ref5, close5, prices.lastDay, prices.lastClose) : na, recentComparisons(prices, comparisonAnchor),
     recentSession(prices.lastDay, comparisonAnchor) ? ma.recent : na]

remoteComparison(float reversalPct, int oneYear, int threeYears, int fiveYears, bool useSEK, float price, bool missingFx, int previousDay, float previousPrice, bool previousFxMissing) =>
    var PriceHistory prices = newPriceHistory()
    var DipHistory dips = DipHistory.new(array.new<int>(1, 0))
    var CompareMaHistory ma = newCompareMaHistory()
    var array<float> levels = array.from(10.0)
    float mean = compareSma(price, useSEK and syminfo.currency != currency.SEK)
    // The previous native bar is final even during a delayed feed's open bar.
    // Include the current native bar only if historical and past its own close.
    if not na(previousDay) and (na(prices.lastDay) or prices.lastDay < previousDay)
        prices.addClose(previousDay, previousPrice)
        prices.missingFx := prices.missingFx or previousFxMissing
        dips.addDipClose(previousDay, previousPrice, reversalPct, levels, true)
        ma.addMaClose(previousDay, previousPrice, mean[1])
    if barstate.ishistory and time_close <= timenow and (na(prices.lastDay) or prices.lastDay < time_tradingday)
        prices.addClose(time_tradingday, price)
        prices.missingFx := prices.missingFx or missingFx
        dips.addDipClose(time_tradingday, price, reversalPct, levels, true)
        ma.addMaClose(time_tradingday, price, mean)
    comparisonMetrics(prices, dips, ma, oneYear, threeYears, fiveYears, useSEK)

const int ROW_CAGR = 0
const int ROW_1Y = 1
const int ROW_3Y = 2
const int ROW_5Y = 3
const int ROW_CURRENT_DD = 4
const int ROW_MAX_DD = 5
const int ROW_ACTIVE_DIP = 6
const int ROW_DIPS = 7
const int ROW_OPPORTUNITY = 8
const int ROW_RARITY = 9
const int ROW_MA_DISTANCE = 10
const int ROW_MA_PERCENTILE = 11

type ComparisonColumn
    string tickerId
    string currency
    int firstDay
    int lastDay
    int ref1
    int ref3
    int ref5
    int dipCount
    int observedDays
    int invalidBars
    bool missingFx
    float yearsPerDip
    float cagr3
    float cagr5
    float quality
    array<float> values
    array<ComparisonSnapshot> snapshots
    array<MaComparison> maSnapshots

comparisonColumn(string symbol, string quoteCurrency, int start, int finish, int ref1, int ref3, int ref5, int dipCount, int observed, int invalid, bool missingFx, float cagr, float ret1, float ret3, float ret5, float currentDD, float maxDD, float activeDip, float rate, float interval, float cagr3, float cagr5, array<ComparisonSnapshot> snapshots, array<MaComparison> maSnapshots) =>
    float quality = missingFx ? na : 0.7 * cagr3 + 0.3 * cagr5
    array<float> values = missingFx ? array.new<float>(ROW_OPPORTUNITY) : array.from(cagr, ret1, ret3, ret5, currentDD, maxDD, activeDip, rate)
    ComparisonColumn.new(symbol, quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, interval, cagr3, cagr5, quality, values, snapshots, maSnapshots)

canonicalSymbol(string tickerId) =>
    str.replace_all(ticker.standard(tickerId), "_DLY:", ":")

var array<string> extraSymbols = array.new<string>()
var array<ComparisonColumn> columns = array.new<ComparisonColumn>()
if comparisonPanel
    var CompareMaHistory ma = newCompareMaHistory()
    float mean = compareInSEK and syminfo.currency != currency.SEK ? compareSma(comparisonClose, true) : smaForDay
    if confirmedDay
        ma.addMaClose(time_tradingday, comparisonClose, mean)
    if barstate.isfirst
        array<string> symbols = array.from(symbolA, symbolB, symbolC, symbolD)
        array<bool> enabled = array.from(includeA, includeB, includeC, includeD)
        string chartSymbol = canonicalSymbol(syminfo.tickerid)
        for [index, symbol] in symbols
            string standardSymbol = canonicalSymbol(symbol)
            if enabled.get(index) and symbol != "" and standardSymbol != chartSymbol and not extraSymbols.includes(standardSymbol)
                extraSymbols.push(standardSymbol)
    [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, currentDD, maxDD, activeDip, rate, interval, cagr3, cagr5, opportunities, maSnapshots] = comparisonMetrics(chartPrices, chartDips, ma, oneYearTarget, threeYearTarget, fiveYearTarget, compareInSEK)
    if barstate.islast
        columns.clear()
        columns.push(comparisonColumn(canonicalSymbol(syminfo.tickerid), quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, currentDD, maxDD, activeDip, rate, interval, cagr3, cagr5, opportunities, maSnapshots))
if comparisonPanel
    for symbol in extraSymbols
        [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, currentDD, maxDD, activeDip, rate, interval, cagr3, cagr5, opportunities, maSnapshots] = request.security(symbol, "1D",
             remoteComparison(reversal, oneYearTarget, threeYearTarget, fiveYearTarget, compareInSEK, comparisonClose, comparisonFxMissing, time_tradingday[1], comparisonClose[1], comparisonFxMissing[1]),
             lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
        if barstate.islast
            columns.push(comparisonColumn(symbol, quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, currentDD, maxDD, activeDip, rate, interval, cagr3, cagr5, opportunities, maSnapshots))

comparisonStart(ComparisonColumn asset, int row) =>
    switch row
        ROW_1Y => asset.ref1
        ROW_3Y => asset.ref3
        ROW_5Y => asset.ref5
        => asset.firstDay

sameComparisonDateAndCurrency(ComparisonColumn left, ComparisonColumn right) =>
    not na(left.currency) and left.currency != "" and left.currency == right.currency and not na(left.lastDay) and left.lastDay == right.lastDay

rankedValue(ComparisonColumn asset, int row) =>
    float value = asset.values.get(row)
    row == ROW_CURRENT_DD ? (asset.quality > 0 ? -value : na) : value

comparisonColor(array<ComparisonColumn> assets, ComparisonColumn asset, int row) =>
    float value = asset.values.get(row)
    color result = na(value) ? MUTED_COLOR : VALUE_COLOR
    float rank = rankedValue(asset, row)
    if not na(rank) and row <= ROW_MAX_DD
        int start = comparisonStart(asset, row)
        float rounded = math.round(rank, 2)
        float lowest = rounded
        float highest = rounded
        for other in assets
            float otherRank = rankedValue(other, row)
            bool samePeriod = row == ROW_CURRENT_DD or start == comparisonStart(other, row)
            if not na(otherRank) and samePeriod and sameComparisonDateAndCurrency(asset, other)
                float otherRounded = math.round(otherRank, 2)
                lowest := math.min(lowest, otherRounded)
                highest := math.max(highest, otherRounded)
        if lowest < highest
            result := rounded == lowest ? LOW_COLOR : rounded == highest ? BEST_COLOR : VALUE_COLOR
    result

comparisonForCutoff(ComparisonColumn asset, int cutoff) =>
    ComparisonSnapshot selected = na
    if not na(asset.snapshots) and not na(cutoff)
        for snapshot in asset.snapshots
            if snapshot.cutoff == cutoff
                selected := snapshot
                break
    selected

opportunityForCutoff(ComparisonColumn asset, int cutoff) =>
    ComparisonSnapshot snapshot = comparisonForCutoff(asset, cutoff)
    not na(snapshot) and not na(snapshot.score) ? snapshot : na

eligibleOpportunity(ComparisonColumn asset, int anchor) =>
    not asset.missingFx and recentSession(asset.lastDay, anchor) and not na(opportunityForCutoff(asset, asset.lastDay))

type OpportunityGroup
    int cutoff = na
    int count = 0
    float lowest = na
    float highest = na
    int leader = na

opportunityGroup(array<ComparisonColumn> assets, string quoteCurrency, int anchor) =>
    OpportunityGroup best = OpportunityGroup.new()
    for offset = 0 to OPPORTUNITY_LAG_DAYS
        int cutoff = anchor - offset * MS_PER_DAY
        OpportunityGroup candidate = OpportunityGroup.new(cutoff)
        for [index, asset] in assets
            // A fresh qualified close at or after the cutoff verifies coverage.
            if asset.currency == quoteCurrency and asset.lastDay >= cutoff and eligibleOpportunity(asset, anchor)
                ComparisonSnapshot snapshot = opportunityForCutoff(asset, cutoff)
                if not na(snapshot)
                    float rounded = math.round(snapshot.score, 1)
                    candidate.count += 1
                    candidate.lowest := math.min(nz(candidate.lowest, rounded), rounded)
                    if na(candidate.highest) or rounded > candidate.highest
                        candidate.highest := rounded
                        candidate.leader := index
                    else if rounded == candidate.highest
                        candidate.leader := na
        // Prefer the most participants, then the latest cutoff. Scores never choose the date.
        if candidate.count > best.count
            best := candidate
    best

opportunityGroups(array<ComparisonColumn> assets, int anchor) =>
    map<string, OpportunityGroup> groups = map.new<string, OpportunityGroup>()
    int leader = na
    int comparableGroups = 0
    for asset in assets
        if not na(asset.currency) and asset.currency != "" and not groups.contains(asset.currency)
            OpportunityGroup group = opportunityGroup(assets, asset.currency, anchor)
            groups.put(asset.currency, group)
            if group.count >= 2
                comparableGroups += 1
                leader := group.leader
    [groups, comparableGroups == 1 ? leader : na, comparableGroups]

opportunityColor(OpportunityGroup group, ComparisonSnapshot snapshot) =>
    color result = na(snapshot) ? MUTED_COLOR : VALUE_COLOR
    if not na(snapshot) and group.count >= 2 and group.lowest < group.highest
        float rounded = math.round(snapshot.score, 1)
        result := rounded == group.highest ? BEST_COLOR : rounded == group.lowest ? LOW_COLOR : VALUE_COLOR
    result

opportunityDetail(ComparisonColumn asset, OpportunityGroup group, ComparisonSnapshot snapshot, int comparableGroups) =>
    string detail = "Historical heuristic · Quality (70% 3Y CAGR + 30% 5Y CAGR) × recovery upside to the historical high."
    if na(snapshot)
        string reason = asset.missingFx ? "SEK conversion incomplete." : not recentSession(asset.lastDay, comparisonAnchor) ? "No confirmed close within the last four calendar days." : "Positive Quality, a drawdown and valid 3Y/5Y references are required at the cutoff."
        detail += "\n" + reason
    else
        detail += "\nAs of " + formatDay(snapshot.cutoff) + " · " + asset.currency + " · Close " + formatDay(snapshot.endDay)
        detail += "\nReferences: " + formatDay(snapshot.ref3) + " (3Y) · " + formatDay(snapshot.ref5) + " (5Y)"
        detail += "\nQuality " + formatPercent(snapshot.quality) + " · DD " + formatPercent(snapshot.drawdown)
        if group.count < 2
            detail += "\nAt least two comparable candidates are required."
        else if comparableGroups > 1
            detail += "\nColors compare within currency. Multiple groups have eligible candidates."
        else if na(group.leader)
            detail += "\nThe highest displayed score is tied."
    detail

comparisonDetail(ComparisonColumn asset, int row) =>
    string dates = "Loaded history: " + formatPeriod(asset.firstDay, asset.lastDay) + "."
    if asset.missingFx
        dates += "\nSEK conversion is missing for at least one valid close. Choose Native to view the series in its own currency."
    string detail = switch row
        ROW_1Y => "Reference " + formatDay(asset.ref1) + " · Shared target " + formatDay(oneYearTarget) + "."
        ROW_3Y => "Reference " + formatDay(asset.ref3) + " · Shared target " + formatDay(threeYearTarget) + ".\n3Y CAGR: " + formatPercent(asset.missingFx ? na : asset.cagr3) + "."
        ROW_5Y => "Reference " + formatDay(asset.ref5) + " · Shared target " + formatDay(fiveYearTarget) + ".\n5Y CAGR: " + formatPercent(asset.missingFx ? na : asset.cagr5) + "."
        ROW_CURRENT_DD => "Latest confirmed close relative to the highest observed close. Color compares discounts among symbols with positive Quality and matching end date and currency."
        ROW_MAX_DD => "Lowest observed drawdown over the loaded history. A value closer to zero ranks higher."
        ROW_ACTIVE_DIP => "Latest confirmed close relative to the local episode peak."
        ROW_DIPS => na(asset.dipCount) ? "Daily history unavailable." : str.tostring(asset.dipCount) + " completed dips ≥10% · " + str.tostring(asset.observedDays, "#,##0") + " observed calendar days."
        => "Annualized price return using elapsed calendar days."
    if row >= ROW_1Y and row <= ROW_5Y
        detail += "\nLatest confirmed: " + formatDay(asset.lastDay) + " · Shared end target: " + formatDay(comparisonAnchor) + "."
    if row == ROW_DIPS and not na(asset.dipCount) and not asset.missingFx
        if asset.invalidBars > 0
            detail += "\n" + str.tostring(asset.invalidBars) + " invalid closes break episode coverage."
        if na(asset.values.get(row))
            detail += "\nAt least one calendar year of observed coverage is required."
        detail += "\nObserved frequency."
    detail + "\n" + dates

formatOpportunity(float value) =>
    na(value) ? "N/A" : math.round(value, 1) == 0 ? "<0.1" : str.tostring(value, "0.0")

hasDipRarity(ComparisonSnapshot snapshot) =>
    not na(snapshot) and not na(snapshot.rarityDays)

dipRarityCutoff(array<ComparisonColumn> assets, string quoteCurrency, int opportunityCutoff, int anchor) =>
    int selected = opportunityCutoff
    // A group can have valid rarity even when every Opportunity score is unavailable.
    if na(opportunityCutoff)
        int mostCovered = 0
        for offset = 0 to OPPORTUNITY_LAG_DAYS
            int cutoff = anchor - offset * MS_PER_DAY
            int covered = 0
            for asset in assets
                if asset.currency == quoteCurrency and hasDipRarity(comparisonForCutoff(asset, cutoff))
                    covered += 1
            if covered > mostCovered
                selected := cutoff
                mostCovered := covered
    selected

formatDipRarity(int count, int days) =>
    str.tostring(100.0 * (1.0 - float(count) / days), "0.0") + "%"

dipRarityDetail(ComparisonSnapshot snapshot, int cutoff, bool missingFx) =>
    string detail = "Share of daily drawdowns shallower than the cutoff drawdown."
    if not na(cutoff)
        detail += "\nFrom " + formatDay(yearsEarlier(cutoff, 5)) + " · As of " + formatDay(cutoff)
    if hasDipRarity(snapshot)
        detail += "\n" + str.tostring(snapshot.rarityCount, "#,##0") + " of " + str.tostring(snapshot.rarityDays, "#,##0") + " sessions at least as deep."
        if snapshot.endDay != cutoff
            detail += " Last close: " + formatDay(snapshot.endDay) + "."
    else
        detail += missingFx ? "\nSEK conversion incomplete." : "\nValid five-year coverage and a confirmed close near the cutoff are required."
    detail

maComparisonForCutoff(ComparisonColumn asset, int cutoff) =>
    MaComparison selected = na
    if not asset.missingFx and not na(asset.maSnapshots) and not na(cutoff) and asset.lastDay >= cutoff
        for snapshot in asset.maSnapshots
            if snapshot.day > cutoff
                break
            if recentSession(snapshot.day, comparisonAnchor)
                selected := snapshot
    selected

maComparisonDetail(ComparisonColumn asset, MaComparison snapshot, int cutoff, bool chartSymbol) =>
    string period = maYears == 0 ? "All available" : str.tostring(maYears) + " years"
    string detail = "SMA " + str.tostring(smaLength) + " " + smaTimeframe + (smoothSma and smaTimeframe != "Daily" ? " · Smooth" : "")
    detail += na(asset.currency) ? "" : " · " + asset.currency
    detail += "\nPrior signed daily distances · " + period
    if not na(cutoff)
        detail += "\nAs of " + formatDay(cutoff)
    if asset.missingFx
        detail += "\nSEK conversion incomplete."
    else if na(cutoff)
        detail += "\nNo Opportunity date for this currency."
    else if na(snapshot)
        detail += "\nNo confirmed coverage at the comparison date."
    else
        detail += "\nClose " + formatDay(snapshot.day)
        if snapshot.priorCount > 0
            detail += "\n" + formatPeriod(snapshot.firstPriorDay, snapshot.lastPriorDay) + " · " + str.tostring(snapshot.priorCount, "#,##0") + " prior sessions"
        if na(snapshot.distance)
            detail += "\nA valid close and SMA are required."
        else if not snapshot.covered
            detail += "\nMore valid SMA history is needed for this period."
        else if na(snapshot.percentile)
            detail += "\nAt least " + str.tostring(MIN_MA_DISTANCES) + " prior sessions are required" + (math.sign(snapshot.distance) != 0 ? " on this side." : ".")
        else
            detail += "\nExtreme thresholds P" + str.tostring(maExtremePercentile) + " / P" + str.tostring(100 - maExtremePercentile) + "."
    if chartSymbol and compareInSEK and syminfo.currency != currency.SEK
        detail += "\nThe chart SMA uses " + syminfo.currency + "."
    detail

maCell(table panel, int column, int row, string value, string detail, color extreme = na) =>
    color valueColor = value == "N/A" or value == "—" ? MUTED_COLOR : na(extreme) ? VALUE_COLOR : extreme
    table.cell(panel, column, row, value, text_color = valueColor, text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = detail)

renderComparison(table panel, array<ComparisonColumn> assets, int firstRow) =>
    var array<string> labels = array.from("CAGR", "1Y", "3Y", "5Y", "Current DD", "Max DD", "Active Dip", "Dips ≥10%", "Opportunity", "Dip Rarity", "MA Distance", "MA Percentile")
    [groups, leader, comparableGroups] = opportunityGroups(assets, comparisonAnchor)
    if firstRow > 0
        // Leave space for TradingView's chart controls in the top-right corner.
        table.cell(panel, 0, 0, " ", text_size = size.small)
    table.cell(panel, 0, firstRow, compareInSEK ? "SEK" : "Native", text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = SECTION_BG)
    for [row, label] in labels
        table.cell(panel, 0, firstRow + row + 1, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG)
    for [index, asset] in assets
        int column = index + 1
        array<string> parts = str.split(asset.tickerId, ":")
        OpportunityGroup group = na(asset.currency) ? na : groups.get(asset.currency)
        ComparisonSnapshot snapshot = na
        if not na(group) and asset.lastDay >= group.cutoff and eligibleOpportunity(asset, comparisonAnchor)
            snapshot := opportunityForCutoff(asset, group.cutoff)
        bool isLeader = index == leader
        string name = parts.last() + (isLeader ? " ★" : "")
        string headerDetail = asset.tickerId + (na(asset.currency) ? "" : " · " + asset.currency)
        headerDetail += "\nLatest confirmed: " + formatDay(asset.lastDay) + ".\nLoaded history: " + formatPeriod(asset.firstDay, asset.lastDay) + "."
        headerDetail += "\nPrice adjustments depend on the symbol's feed."
        if isLeader
            headerDetail += "\nHighest comparable Opportunity as of " + formatDay(group.cutoff) + "."
        table.cell(panel, column, firstRow, name, text_color = isLeader ? BEST_COLOR : VALUE_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = SECTION_BG, tooltip = headerDetail)
        for [row, value] in asset.values
            string displayValue = row == ROW_DIPS ? dipFrequencyText(asset.dipCount, value, asset.yearsPerDip) : formatPercent(value)
            table.cell(panel, column, firstRow + row + 1, displayValue, text_color = comparisonColor(assets, asset, row), text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = comparisonDetail(asset, row))
        string score = na(snapshot) ? "N/A" : formatOpportunity(snapshot.score)
        table.cell(panel, column, firstRow + ROW_OPPORTUNITY + 1, score, text_color = opportunityColor(group, snapshot), text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = opportunityDetail(asset, group, snapshot, comparableGroups))
        int rarityCutoff = not na(group) ? dipRarityCutoff(assets, asset.currency, group.cutoff, comparisonAnchor) : na
        ComparisonSnapshot rarity = comparisonForCutoff(asset, rarityCutoff)
        bool validRarity = hasDipRarity(rarity)
        string rarityValue = validRarity ? formatDipRarity(rarity.rarityCount, rarity.rarityDays) : "N/A"
        table.cell(panel, column, firstRow + ROW_RARITY + 1, rarityValue, text_color = validRarity ? VALUE_COLOR : MUTED_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = dipRarityDetail(rarity, rarityCutoff, asset.missingFx))
        int maCutoff = na(group) ? na : group.cutoff
        MaComparison ma = maComparisonForCutoff(asset, maCutoff)
        string detail = maComparisonDetail(asset, ma, maCutoff, index == 0)
        float distance = na(ma) ? na : ma.distance
        string distanceText = (math.sign(distance) == 1 ? "+" : "") + formatPercent(distance)
        string percentileText = na(ma) or na(ma.percentile) ? "N/A" : "P" + str.tostring(ma.percentile, "0.0")
        color extreme = na(ma) or ma.extreme == 0 ? na : ma.extreme > 0 ? LOW_COLOR : BEST_COLOR
        maCell(panel, column, firstRow + ROW_MA_DISTANCE + 1, distanceText, detail, extreme)
        maCell(panel, column, firstRow + ROW_MA_PERCENTILE + 1, percentileText, detail, extreme)

formatMaDistance(float magnitude, bool above) =>
    na(magnitude) ? "N/A" : (above ? "+" : "−") + formatPercent(magnitude)

formatMaDuration(float length) =>
    na(length) ? "N/A" : str.tostring(length, length == int(length) ? "#,##0" : "#,##0.0")

renderMaBehavior(table panel, MaSummary history, int firstRow) =>
    var array<string> labels = array.from("Time %", "Median Distance", "P90 Distance", "Median Duration", "P90 Duration", "Current Duration", "Current Stretch")
    if firstRow > 0
        table.cell(panel, 0, 0, " ", text_size = size.small)
    table.cell(panel, 0, firstRow, "", bgcolor = SECTION_BG)
    for [index, label] in labels
        table.cell(panel, 0, firstRow + index + 1, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG)

    int total = history.above.sessions + history.below.sessions + history.equalCount
    string window = "\n" + formatPeriod(history.startDay, history.endDay) + "."
    if not history.covered
        window += " The selected calendar period needs more valid MA history."
    string timeDetail = str.tostring(total, "#,##0") + " comparable sessions including closes equal to MA. At least " + str.tostring(MIN_MA_SESSIONS) + " required." + window
    for column = 1 to 2
        bool above = column == 1
        table.cell(panel, column, firstRow, above ? "Above" : "Below", text_color = VALUE_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = SECTION_BG)
        MaSideSummary stats = above ? history.above : history.below
        bool current = history.side == (above ? 1 : -1)
        color extreme = above ? LOW_COLOR : BEST_COLOR
        string duration = current ? (history.runStartKnown ? "" : "≥") + formatMaDuration(history.runLength) : history.comparable ? "—" : "N/A"
        string distanceDetail = str.tostring(stats.sessions, "#,##0") + " sessions on this side. At least " + str.tostring(MIN_MA_DISTANCES) + " required." + window
        string runDetail = str.tostring(stats.runs, "#,##0") + " complete runs. At least " + str.tostring(MIN_MA_RUNS) + " required. Durations count trading sessions." + window
        string currentDetail = "Consecutive trading sessions on this side. ≥ marks an unobserved start."
        string stretchDetail = "Share of prior same-side distances no greater in magnitude than today's." + (current ? " Current distance: " + formatMaDistance(math.abs(history.distance), above) + "." : "") + "\nAt least " + str.tostring(MIN_MA_DISTANCES) + " prior sessions required." + window
        maCell(panel, column, firstRow + 1, formatPercent(history.covered and total >= MIN_MA_SESSIONS ? 100.0 * stats.sessions / total : na), timeDetail)
        maCell(panel, column, firstRow + 2, formatMaDistance(stats.medianDistance, above), distanceDetail)
        maCell(panel, column, firstRow + 3, formatMaDistance(stats.p90Distance, above), distanceDetail)
        maCell(panel, column, firstRow + 4, formatMaDuration(stats.medianDuration), runDetail)
        maCell(panel, column, firstRow + 5, formatMaDuration(stats.p90Duration), runDetail)
        maCell(panel, column, firstRow + 6, duration, currentDetail)
        maCell(panel, column, firstRow + 7, current ? formatPercent(history.stretch) : history.comparable ? "—" : "N/A", stretchDetail, current and history.event != 0 ? extreme : na)

string panelPosition = switch panelCorner
    "Top left" => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left" => position.bottom_left
    => position.top_right

bool dipsPanel = supportedChart and showDips
int panelFirstRow = panelCorner == "Top right" ? 1 : 0
int panelRows = maBehaviorPanel ? 8 + panelFirstRow : not supportedChart ? 1 : comparisonPanel ? ROW_MA_PERCENTILE + 2 + panelFirstRow : dipsPanel ? (orderedThresholds ? 6 : 3) : 7
int panelColumns = comparisonPanel ? 2 + extraSymbols.size() : maBehaviorPanel ? 3 : dipsPanel ? 2 : 4
bool cellBackgrounds = comparisonPanel or maBehaviorPanel
var table panel = table.new(panelPosition, panelColumns, panelRows, bgcolor = cellBackgrounds ? na : PANEL_BG, frame_color = SECTION_BG, frame_width = cellBackgrounds ? 0 : 1)
if barstate.isfirst
    if dipsPanel
        table.merge_cells(panel, 0, 0, 1, 0)
        if not orderedThresholds
            table.merge_cells(panel, 0, 2, 1, 2)
    else if not comparisonPanel and not maBehaviorPanel
        table.merge_cells(panel, 0, 0, 3, 0)
        if supportedChart
            table.merge_cells(panel, 0, 5, 3, 5)

if barstate.islast
    int lastDay = chartPrices.lastDay
    float lastClose = chartPrices.lastClose
    int firstDay = chartPrices.firstDay
    if comparisonPanel
        renderComparison(panel, columns, panelFirstRow)
    else if maBehaviorPanel
        if not na(activeMa)
            renderMaBehavior(panel, activeMa.summary, panelFirstRow)
        else
            table.cell(panel, 0, panelFirstRow, "Daily history unavailable", bgcolor = PANEL_BG, text_color = MUTED_COLOR, text_size = size.small)
    else if dipsPanel
        band(panel, 0, "Dips")
        string activeDetail = "Latest confirmed close relative to the current local peak."
        if na(lastClose)
            activeDetail += " Latest confirmed close unavailable."
        metric(panel, 0, 1, "Active Dip", changePercent(lastClose, chartDips.top), activeDetail)
        if orderedThresholds
            string coverage = formatPeriod(firstDay, lastDay)
            coverage += " · " + str.tostring(chartDips.observedDays, "#,##0") + " observed calendar days."
            if chartDips.invalidBars > 0
                coverage += "\n" + str.tostring(chartDips.invalidBars) + " invalid closes · " + str.tostring(chartDips.interrupted) + " interrupted dips excluded."
            for [index, threshold] in thresholds
                dipMetric(panel, index + 2, threshold, chartDips.counts.get(index), chartDips.observedDays, firstDay, coverage)
        else
            band(panel, 2, "Enter increasing dip thresholds")
    else if supportedChart
        float lastSma = barstate.isconfirmed ? smaForDay : smaForDay[1]

        float priceReturn = 100 * (priceRatio(chartPrices) - 1)
        float cagr = annualizedReturn(chartPrices)
        float currentDrawdown = changePercent(lastClose, chartPrices.peakClose)
        float maxDrawdown = maximumDrawdown(chartPrices)
        float smaDistance = changePercent(lastClose, lastSma)
        float shareAbove = comparableDays > 0 ? 100.0 * aboveSmaDays / comparableDays : na

        string dateDetail = "First valid close to latest confirmed session in TradingView's loaded history."
        if not na(lastDay) and na(lastClose)
            dateDetail += " Latest confirmed close unavailable."
        band(panel, 0, formatPeriod(firstDay, lastDay), dateDetail)
        metric(panel, 0, 1, "Return", priceReturn, "Price return since the first valid close. Adjustments follow the chart's price series.")
        metric(panel, 2, 1, "CAGR", cagr, "Annualized price return using elapsed calendar days.")
        periodMetric(panel, 0, 2, 1, lastDay, lastClose, chartPrices)
        periodMetric(panel, 2, 2, 3, lastDay, lastClose, chartPrices)
        periodMetric(panel, 0, 3, 5, lastDay, lastClose, chartPrices)
        periodMetric(panel, 2, 3, 10, lastDay, lastClose, chartPrices)
        metric(panel, 0, 4, "Current DD", currentDrawdown, "Latest confirmed close relative to the highest observed close.")
        metric(panel, 2, 4, "Max DD", maxDrawdown, "Lowest observed drawdown over the loaded history.")
        string unit = smaTimeframe == "Daily" ? "D" : smaTimeframe == "Weekly" ? "W" : "M"
        string maLabel = "SMA " + str.tostring(smaLength) + unit
        if smoothSma and smaTimeframe != "Daily"
            maLabel += " · Smooth"
        band(panel, 5, maLabel, "Uses consecutive valid closes on the selected timeframe. Weekly and monthly values become available in the next period.")
        metric(panel, 0, 6, "MA Distance", smaDistance, "Latest confirmed daily close relative to its available SMA.")
        metric(panel, 2, 6, "Above MA", shareAbove, str.tostring(comparableDays, "#,##0") + " comparable days. Closes equal to SMA are included in the denominator.")
    else
        string instruction = supportedMaChart ? "Use a 1D chart or select MA Behavior" : "Use a standard time-based chart"
        band(panel, 0, "Macro Analysis · " + instruction)
