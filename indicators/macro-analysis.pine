//@version=6
indicator("Macro Analysis", overlay = true, behind_chart = false, max_lines_count = 100, max_labels_count = 100)

const int MS_PER_DAY = 86400000
const float DAYS_PER_YEAR = 365.25
// Ten calendar years contain at most 3,653 daily sessions. Keep room for the
// predecessor of the oldest target even when there are no sessions near it.
const int PERIOD_HISTORY_SIZE = 4096
const string SESSION_ZONE = "UTC+0"
const int OPPORTUNITY_LAG_DAYS = 4
const int OPPORTUNITY_DECIMALS = 2
const int MAX_VISIBLE_LEGS = 96
const int SWING_RISK_WEEKS = 52
const int STABLECOIN_MAX_AGE_DAYS = 2
const int FIAT_FX_MAX_AGE_DAYS = 5
const float COMPARE_DIP_THRESHOLD = 10.0

const color PANEL_BG = #171B23
const color SECTION_BG = #29323F
const color LABEL_COLOR = #C4CEDA
const color VALUE_COLOR = #F2F5F9
const color MUTED_COLOR = #9EAFC2
const string MISSING_VALUE = "Missing"
const color BEST_COLOR = #82D6A9
const color LOW_COLOR = #F3A0A0
const color EXTREME_ABOVE_COLOR = #D75567
const color EXTREME_BELOW_COLOR = #30AE91
const color EXTREME_ABOVE_CANDLE = #BC6D7A
const color EXTREME_BELOW_CANDLE = #549B86
const color ACTIVE_DIP_COLOR = #7FB6CD
const color RARITY_DIP_COLOR = #BAA5DC
const color SWING_UP_COLOR = #78C5AC
const color SWING_DOWN_COLOR = #E68C9E
const int MIN_MA_SESSIONS = 20
const int MIN_MA_DISTANCES = 30
const int MIN_MA_RUNS = 10

int smaLength = input.int(200, "SMA", minval = 2, inline = "sma")
string smaTimeframe = input.string("Daily", "", options = ["Daily", "Weekly", "Monthly"], inline = "sma")
bool showSma = input.bool(true, "", inline = "sma", tooltip = "Length, timeframe, and whether to show the SMA line.")
bool smoothSma = input.bool(false, "Smooth SMA", active = smaTimeframe != "Daily", tooltip = "Moves gradually to the next confirmed weekly or monthly SMA.")
string panelCorner = input.string("Top right", "Panel corner", options = ["Top right", "Top left", "Bottom right", "Bottom left"])
string panelView = input.string("Overview", "Panel View", options = ["Overview", "Dips", "Compare", "MA Behavior"])
bool showDips = panelView == "Dips"
bool showCompare = panelView == "Compare"
bool showMaBehavior = panelView == "MA Behavior"
bool colorExtremeCandles = input.bool(false, "Color Extreme Candles")
bool showExtremeEntries = input.bool(false, "Show Extreme Entry Markers", tooltip = "Mark confirmed entries into extreme SMA-distance zones.")
int maExtremePercentile = input.int(95, "Extreme Percentile", minval = 55, maxval = 100, active = showCompare or showMaBehavior or colorExtremeCandles or showExtremeEntries, tooltip = "Upper percentile of signed daily distances. The lower threshold uses the complementary percentile. A new entry requires leaving the zone.")
string maStatisticsPeriod = input.string("5 Years", "MA Statistics Period", options = ["5 Years", "10 Years", "All Available"], active = showCompare or showMaBehavior or colorExtremeCandles or showExtremeEntries)
string compareCurrency = input.string("SEK", "Compare currency", options = ["SEK", "EUR", "USD", "Native"], active = showCompare)
string chartLines = input.string("Off", "Chart lines", options = ["Off", "Swing legs", "Dip episodes"],
     tooltip = "Standard 1D. Swing legs show structural moves, with exact daily endpoints. Dip episodes and Active Dip are available in Dips and Compare.")
bool showSwingLegs = chartLines == "Swing legs"
bool showDipMarks = chartLines == "Dip episodes"
float swingScale = input.float(2.0, "Swing scale", minval = 0.5, maxval = 5.0, step = 0.25, active = not showMaBehavior or showSwingLegs,
     tooltip = "Multiple of the median relative range of 52 completed weeks. Applies to chart swings and dip statistics.")
bool useWicks = input.string("Close", "Drawdown prices", options = ["Close", "Wicks"], active = not showMaBehavior or showSwingLegs, tooltip = "Applied to drawdowns, dips and swing legs, Dip Rarity and Opportunity's drawdown. Returns and SMA use closing prices.") == "Wicks"
bool showRarityMark = input.bool(false, "Dip Rarity reference", active = showCompare, tooltip = "Mark the chart symbol's Rarity drawdown on standard 1D. The line uses chart prices and the value uses the comparison currency.")
float dipFirst = input.float(5, "Dip thresholds (%)", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipSecond = input.float(10, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipThird = input.float(20, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips)
float dipFourth = input.float(30, "", minval = 0, maxval = 100, inline = "dipThresholds", active = showDips, tooltip = "Enter four thresholds in strictly increasing order.")
bool includeA = input.bool(true, "Symbol 1", inline = "compareA", active = showCompare)
string symbolA = input.symbol("BATS:ACWI", "", inline = "compareA", active = showCompare and includeA)
bool includeB = input.bool(true, "Symbol 2", inline = "compareB", active = showCompare)
string symbolB = input.symbol("XETR:EUNL", "", inline = "compareB", active = showCompare and includeB)
bool includeC = input.bool(true, "Symbol 3", inline = "compareC", active = showCompare)
string symbolC = input.symbol("XETR:VWCE", "", inline = "compareC", active = showCompare and includeC)
bool includeD = input.bool(true, "Symbol 4", inline = "compareD", active = showCompare)
string symbolD = input.symbol("OMXSTO:XACTHDIV", "", inline = "compareD", active = showCompare and includeD)
bool orderedThresholds = dipFirst < dipSecond and dipSecond < dipThird and dipThird < dipFourth
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
bool supportedChart = isDaily and chart.is_standard
bool supportedMaChart = chart.is_standard and (timeframe.isseconds or timeframe.isminutes or timeframe.isdwm)
bool confirmedDay = supportedChart and barstate.isconfirmed
bool comparisonPanel = supportedChart and showCompare
bool dipMarksVisible = supportedChart and showDipMarks and (showDips or showCompare)
bool swingMarksVisible = supportedChart and showSwingLegs
bool rarityMarkVisible = comparisonPanel and showRarityMark

validPrice(float price) =>
    math.sign(price) == 1 ? price : na

validWicks(float hi, float lo) =>
    math.sign(lo) == 1 and math.sign(hi - lo) >= 0

type FxQuote
    string stablecoin
    float stableUsd
    int stableCloseAt
    string targetCurrency
    float usdTarget
    int targetCloseAt

fxBeforeSession(float recent, int recentAt, float previous, int previousAt, int maxAge) =>
    bool useRecent = not na(recentAt) and recentAt <= time
    int observedAt = useRecent ? recentAt : previousAt
    float price = useRecent ? recent : previous
    [not na(observedAt) and observedAt <= time and time - observedAt <= maxAge * MS_PER_DAY ? validPrice(price) : na, observedAt]

stablecoinQuote(string stablecoin, simple string targetCurrency) =>
    string tickerId = stablecoin == "USDT" ? "KRAKEN:USDTUSD" : "KRAKEN:USDCUSD"
    [stable, stableAt, priorStable, priorStableAt] = request.security(tickerId, "1D", [close, time_close, close[1], time_close[1]],
         lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
    [stableUsd, stableCloseAt] = fxBeforeSession(stable, stableAt, priorStable, priorStableAt, STABLECOIN_MAX_AGE_DAYS)
    [usdTarget, targetCloseAt] = if targetCurrency == currency.USD
        [1.0, int(na)]
    else
        string cross = targetCurrency == currency.EUR ? "FX_IDC:USDEUR" : "FX_IDC:USDSEK"
        [current, currentAt, previous, previousAt] = request.security(cross, "1D", [close, time_close, close[1], time_close[1]],
             lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
        fxBeforeSession(current, currentAt, previous, previousAt, FIAT_FX_MAX_AGE_DAYS)
    na(usdTarget) ? na : FxQuote.new(stablecoin, nz(stableUsd, 1.0), na(stableUsd) ? na : stableCloseAt, targetCurrency, usdTarget, targetCloseAt)

// A currency-modified chart still supplies the line coordinates. Compare uses the underlying quote.
string standardTicker = ticker.standard(syminfo.tickerid)
[standardDay, standardClose, standardHigh, standardLow, nativeCurrency] = if comparisonPanel and standardTicker != syminfo.tickerid
    request.security(standardTicker, "1D", [time_tradingday, close, high, low, syminfo.currency], lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
else
    [time_tradingday, close, high, low, syminfo.currency]
bool chartPriceConverted = comparisonPanel and not na(nativeCurrency) and nativeCurrency != syminfo.currency
string sourceTicker = chartPriceConverted ? standardTicker : syminfo.tickerid
string comparisonCurrency = compareCurrency == "Native" ? nativeCurrency : compareCurrency
string chartMeasureCurrency = comparisonPanel ? comparisonCurrency : syminfo.currency
bool differentCurrency = comparisonCurrency != nativeCurrency
bool comparisonUsesOwnPrices = chartPriceConverted or differentCurrency
bool useStablecoinBridge = comparisonPanel and compareCurrency != "Native" and (nativeCurrency == "USDT" or nativeCurrency == "USDC")
FxQuote comparisonFx = useStablecoinBridge ? stablecoinQuote(nativeCurrency, compareCurrency) : na
float comparisonRate = na(comparisonFx) ? na : comparisonFx.stableUsd * comparisonFx.usdTarget
int nativeDay = chartPriceConverted ? standardDay : time_tradingday
float nativeClose = chartPriceConverted ? standardClose : close
float nativeHigh = chartPriceConverted ? standardHigh : high
float nativeLow = chartPriceConverted ? standardLow : low

comparisonPrices(simple bool confirmed) =>
    if na(nativeCurrency) or nativeCurrency == "" or (nativeCurrency == "NONE" and compareCurrency != "Native")
        [int(na), float(na), float(na), float(na)]
    else if useStablecoinBridge
        [nativeDay, nativeClose * comparisonRate, nativeHigh * comparisonRate, nativeLow * comparisonRate]
    else if differentCurrency
        request.security(sourceTicker, "1D", [time_tradingday, close, high, low], gaps = confirmed ? barmerge.gaps_on : barmerge.gaps_off,
             lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true, currency = comparisonCurrency)
    else
        [nativeDay, nativeClose, nativeHigh, nativeLow]

float confirmedClose = confirmedDay ? validPrice(close) : na
[comparisonDay, measuredClose, measuredHigh, measuredLow] = if comparisonPanel
    comparisonPrices(true)
else
    [int(na), float(na), float(na), float(na)]
float comparisonClose = comparisonDay == time_tradingday ? validPrice(measuredClose) : na
float comparisonHigh = comparisonDay == time_tradingday ? measuredHigh : na
float comparisonLow = comparisonDay == time_tradingday ? measuredLow : na
bool comparisonFxMissing = comparisonPanel and differentCurrency and nativeDay == time_tradingday and not na(validPrice(nativeClose)) and na(comparisonClose)
bool comparisonWickFxMissing = comparisonPanel and differentCurrency and nativeDay == time_tradingday and useWicks and validWicks(nativeHigh, nativeLow) and not validWicks(comparisonHigh, comparisonLow)

var int comparableDays = 0
var int aboveSmaDays = 0

changePercent(float value, float reference) =>
    100 * (value / reference - 1)

wickDrawdown(float lowPrice, float priorHigh) =>
    math.min(0.0, changePercent(lowPrice, priorHigh))

type PriceSegment
    int startTime
    float startPrice
    int endTime
    float endPrice
    int startDay = na
    int endDay = na
    float chartStart = na
    float chartEnd = na

segmentDepth(PriceSegment leg) =>
    na(leg) ? na : changePercent(leg.endPrice, leg.startPrice)

type PriceHistory
    array<int> sessionDays
    array<float> sessionCloses
    array<float> sessionDrawdowns
    array<float> wickDrawdowns
    int sessionCount = 0
    float firstClose = na
    int firstDay = na
    float peakClose = na
    int peakCloseDay = na
    float wickPeak = na
    int wickPeakDay = na
    float worstDrawdown = na
    float currentWickDrawdown = na
    float worstWickDrawdown = na
    int validDays = 0
    int lastDay = na
    float lastClose = na
    bool missingFx = false
    PriceSegment worstRange = na
    int firstDrawdownDay = na
    int activeFxGaps = 0
    FxQuote latestFx = na

newPriceHistory() =>
    PriceHistory.new(array.new<int>(PERIOD_HISTORY_SIZE), array.new<float>(PERIOD_HISTORY_SIZE),
         array.new<float>(showCompare and not useWicks ? PERIOD_HISTORY_SIZE : 0), array.new<float>(showCompare and useWicks ? PERIOD_HISTORY_SIZE : 0))

method addClose(PriceHistory history, int day, float price, float hi = na, float lo = na, bool closeFxGap = false, bool wickFxGap = false,
     FxQuote quote = na) =>
    history.missingFx := closeFxGap
    history.latestFx := quote
    if closeFxGap
        history.firstClose := na
        history.firstDay := na
        history.validDays := 0
        history.peakClose := na
        history.peakCloseDay := na
        history.worstDrawdown := na
    if closeFxGap or wickFxGap
        history.activeFxGaps += 1
        history.firstDrawdownDay := na
        history.wickPeak := na
        history.wickPeakDay := na
        history.worstWickDrawdown := na
        history.worstRange := na
    int slot = history.sessionCount % PERIOD_HISTORY_SIZE
    history.sessionDays.set(slot, day)
    history.sessionCloses.set(slot, price)
    history.sessionCount += 1
    history.lastDay := day
    history.lastClose := price
    float drawdown = na
    if not na(price)
        if na(history.firstClose)
            history.firstClose := price
            history.firstDay := day
        history.validDays += 1
        if not useWicks and na(history.firstDrawdownDay)
            history.firstDrawdownDay := day
        if na(history.peakClose) or math.sign(price - history.peakClose) > 0
            history.peakClose := price
            history.peakCloseDay := day
        drawdown := changePercent(price, history.peakClose)
        if na(history.worstDrawdown) or drawdown < history.worstDrawdown
            history.worstDrawdown := drawdown
            if not useWicks
                history.worstRange := PriceSegment.new(na, history.peakClose, na, price, history.peakCloseDay, day)
    if useWicks
        history.currentWickDrawdown := na
        if not na(price) and validWicks(hi, lo)
            if na(history.firstDrawdownDay)
                history.firstDrawdownDay := day
            // Today's low is only comparable with highs from earlier sessions.
            float wickDD = wickDrawdown(lo, history.wickPeak)
            history.currentWickDrawdown := wickDD
            if not na(wickDD) and (na(history.worstWickDrawdown) or wickDD < history.worstWickDrawdown)
                history.worstWickDrawdown := wickDD
                history.worstRange := PriceSegment.new(na, history.wickPeak, na, lo, history.wickPeakDay, day)
            if na(history.wickPeak) or math.sign(hi - history.wickPeak) > 0
                history.wickPeak := hi
                history.wickPeakDay := day
    if showCompare
        if useWicks
            history.wickDrawdowns.set(slot, history.currentWickDrawdown)
        else
            history.sessionDrawdowns.set(slot, drawdown)

priceRatio(PriceHistory history) =>
    history.lastDay > history.firstDay ? history.lastClose / history.firstClose : na

annualizedReturn(PriceHistory history) =>
    int days = int((history.lastDay - history.firstDay) / MS_PER_DAY)
    float ratio = priceRatio(history)
    not na(ratio) ? 100 * (math.pow(ratio, DAYS_PER_YEAR / days) - 1) : na

maximumDrawdown(PriceHistory history) =>
    useWicks ? history.worstWickDrawdown : history.validDays >= 2 ? history.worstDrawdown : na

currentDrawdown(PriceHistory history) =>
    useWicks ? history.currentWickDrawdown : changePercent(history.lastClose, history.peakClose)

hasChartAnchors(PriceSegment leg) =>
    not na(leg) and not na(leg.startTime) and not na(leg.endTime) and not na(validPrice(leg.chartStart)) and not na(validPrice(leg.chartEnd))

chartAnchorDetail(PriceSegment leg) =>
    hasChartAnchors(leg) and chartMeasureCurrency != syminfo.currency ?
         "\nChart " + syminfo.currency + " · " + str.tostring(leg.chartStart, format.mintick) + " → " + str.tostring(leg.chartEnd, format.mintick) : ""

intersectsVisiblePeriod(PriceSegment leg) =>
    hasChartAnchors(leg) and (na(chart.left_visible_bar_time) or leg.endTime >= chart.left_visible_bar_time) and
     (na(chart.right_visible_bar_time) or leg.startTime <= chart.right_visible_bar_time)

drawCompletedDip(PriceSegment dip) =>
    var array<line> segments = array.new<line>()
    var array<label> labels = array.new<label>()
    if intersectsVisiblePeriod(dip)
        float depth = changePercent(dip.endPrice, dip.startPrice)
        bool deep = -depth >= COMPARE_DIP_THRESHOLD
        color ink = deep ? LOW_COLOR : color.new(LABEL_COLOR, 25)
        if segments.size() >= MAX_VISIBLE_LEGS
            line.delete(segments.shift())
            label.delete(labels.shift())
        segments.push(line.new(dip.startTime, dip.chartStart, dip.endTime, dip.chartEnd, xloc = xloc.bar_time, color = ink, width = deep ? 2 : 1))
        labels.push(label.new(dip.endTime, dip.chartEnd, str.tostring(depth, "0.0") + "%", xloc = xloc.bar_time,
             style = label.style_label_up, color = color.new(PANEL_BG, 22), textcolor = ink, size = size.tiny,
             tooltip = (useWicks ? "Completed structural dip · High to low" : "Completed structural dip · Close to close") +
             "\n" + (deep ? "≥10%" : "<10%") + " · " + str.tostring(depth, "0.00") + "% · " + chartMeasureCurrency +
             "\nPeak " + str.format_time(dip.startTime, "yyyy-MM-dd", syminfo.timezone) + " · " + str.tostring(dip.startPrice, format.mintick) +
             "\nTrough " + str.format_time(dip.endTime, "yyyy-MM-dd", syminfo.timezone) + " · " + str.tostring(dip.endPrice, format.mintick) + chartAnchorDetail(dip)))

type SwingPoint
    int at
    int day
    float price
    float threshold
    float chartPrice

swingSegment(SwingPoint origin, SwingPoint extreme) =>
    na(origin) or na(extreme) ? na : PriceSegment.new(origin.at, origin.price, extreme.at, extreme.price, origin.day, extreme.day, origin.chartPrice, extreme.chartPrice)

formatSwingLeg(float move) =>
    (move > 0 ? "+" : "−") + str.tostring(math.abs(move), "0.0") + "%"

swingLegDetail(PriceSegment leg) =>
    (useWicks ? "Wicks" : "Close") + " · " + chartMeasureCurrency + " · Scale " + str.tostring(swingScale) + "× trailing weekly range" +
     "\n" + str.format_time(leg.startTime, "yyyy-MM-dd", syminfo.timezone) + " · " + str.tostring(leg.startPrice, format.mintick) +
     " → " + str.format_time(leg.endTime, "yyyy-MM-dd", syminfo.timezone) + " · " + str.tostring(leg.endPrice, format.mintick) + chartAnchorDetail(leg)

drawCompletedSwing(PriceSegment leg, int confirmedAt) =>
    var array<line> segments = array.new<line>()
    var array<label> labels = array.new<label>()
    if intersectsVisiblePeriod(leg)
        float move = changePercent(leg.endPrice, leg.startPrice)
        color ink = move > 0 ? SWING_UP_COLOR : SWING_DOWN_COLOR
        if segments.size() >= MAX_VISIBLE_LEGS
            line.delete(segments.shift())
            label.delete(labels.shift())
        segments.push(line.new(leg.startTime, leg.chartStart, leg.endTime, leg.chartEnd, xloc = xloc.bar_time, color = ink, width = 2))
        labels.push(label.new(leg.endTime, leg.chartEnd, formatSwingLeg(move), xloc = xloc.bar_time,
             style = move > 0 ? label.style_label_down : label.style_label_up,
             color = color.new(PANEL_BG, 22), textcolor = ink, size = size.tiny,
             tooltip = (move > 0 ? "Rise confirmed by a reversal down." : "Decline confirmed by a reversal up.") +
             "\nConfirmed " + str.format_time(confirmedAt, "yyyy-MM-dd", syminfo.timezone) + "\n" + swingLegDetail(leg)))

type DipHistory
    array<int> counts
    array<float> weekRanges
    int currentWeek = na
    bool completeWeek = false
    float previousWeekClose = na
    float weekHigh = na
    float weekLow = na
    float weekClose = na
    float turnThreshold = na
    bool everReady = false
    int previousValidDay = na
    int firstValidDay = na
    int observedDays = 0
    int invalidBars = 0
    int interrupted = 0
    bool rising = true
    SwingPoint origin = na
    SwingPoint extreme = na
    PriceSegment lastDip = na
    PriceSegment maxDip = na

newDipHistory(int thresholdCount) =>
    DipHistory.new(array.new<int>(thresholdCount, 0), array.new<float>())

method observeSwingRange(DipHistory dips, int week, float price, float hi, float lo) =>
    if na(dips.currentWeek) or week != dips.currentWeek
        if dips.completeWeek and not na(dips.previousWeekClose) and not na(dips.weekClose)
            float relativeRange = math.log(math.max(dips.weekHigh, dips.previousWeekClose) / math.min(dips.weekLow, dips.previousWeekClose))
            if dips.weekRanges.size() == SWING_RISK_WEEKS
                dips.weekRanges.shift()
            dips.weekRanges.push(relativeRange)
            if dips.weekRanges.size() == SWING_RISK_WEEKS
                dips.turnThreshold := swingScale * dips.weekRanges.median()
        dips.previousWeekClose := dips.weekClose
        dips.completeWeek := not na(dips.currentWeek)
        dips.currentWeek := week
        dips.weekHigh := hi
        dips.weekLow := lo
    else
        dips.weekHigh := math.max(nz(dips.weekHigh, hi), hi)
        dips.weekLow := math.min(nz(dips.weekLow, lo), lo)
    dips.weekClose := price

method observeDipDay(DipHistory dips, int day, int at, int week, float price, float hi, float lo, array<float> thresholds,
     float chartHigh = na, float chartLow = na) =>
    float highPrice = useWicks ? hi : price
    float lowPrice = useWicks ? lo : price
    PriceSegment completed = na
    if not na(price) and validWicks(highPrice, lowPrice)
        if na(dips.firstValidDay)
            dips.firstValidDay := day
        if not na(dips.previousValidDay)
            dips.observedDays += int((day - dips.previousValidDay) / MS_PER_DAY)
        dips.previousValidDay := day
        dips.observeSwingRange(week, price, highPrice, lowPrice)
        bool ready = math.sign(dips.turnThreshold) == 1
        dips.everReady := dips.everReady or ready
        if ready
            float priceAtExtreme = dips.rising ? highPrice : lowPrice
            bool newExtreme = na(dips.extreme) or math.sign(priceAtExtreme - dips.extreme.price) == (dips.rising ? 1 : -1)
            if newExtreme
                // Freeze the scale with each new extreme. It comes from prior completed weeks.
                dips.extreme := SwingPoint.new(at, day, priceAtExtreme, dips.turnThreshold, dips.rising ? chartHigh : chartLow)
            else
                float opposite = dips.rising ? lowPrice : highPrice
                float move = dips.rising ? math.log(dips.extreme.price / opposite) : math.log(opposite / dips.extreme.price)
                // A Wick bar that extends the leg cannot also prove a subsequent turn.
                if move >= dips.extreme.threshold
                    completed := swingSegment(dips.origin, dips.extreme)
                    if not dips.rising and not na(completed)
                        dips.lastDip := completed
                        float depth = segmentDepth(completed)
                        if na(dips.maxDip) or depth < segmentDepth(dips.maxDip)
                            dips.maxDip := completed
                        for [level, threshold] in thresholds
                            if -depth >= threshold
                                dips.counts.set(level, dips.counts.get(level) + 1)
                    dips.origin := dips.extreme
                    dips.extreme := SwingPoint.new(at, day, opposite, dips.turnThreshold, dips.rising ? chartLow : chartHigh)
                    dips.rising := not dips.rising
    else
        dips.invalidBars += 1
        if not dips.rising and not na(dips.origin)
            dips.interrupted += 1
        dips.previousValidDay := na
        dips.weekRanges.clear()
        dips.completeWeek := false
        dips.currentWeek := week
        dips.previousWeekClose := na
        dips.weekClose := na
        dips.weekHigh := na
        dips.weekLow := na
        dips.turnThreshold := na
        dips.origin := na
        dips.extreme := na
        dips.rising := true
    completed

type MarketPreview
    int day
    bool developing
    int pendingDay
    float price
    float lowPrice
    float currentDD
    float maxDD
    bool developingMax
    float active
    bool developingActive
    PriceSegment activeLeg
    PriceSegment maxDipLeg
    PriceSegment worstRange
    PriceSegment lastDipLeg
    int drawdownStart
    int fxGaps
    FxQuote fx

marketPreview(PriceHistory prices, DipHistory dips, int sourceDay, int sourceTime, float sourcePrice, float hi, float lo, bool pending, FxQuote sourceFx,
     float chartLow = na) =>
    bool hasPending = pending and not na(sourceDay) and (na(prices.lastDay) or sourceDay > prices.lastDay)
    float price = hasPending ? validPrice(sourcePrice) : na
    bool developing = not na(price)
    bool valid = developing and (not useWicks or validWicks(hi, lo))
    float currentDD = currentDrawdown(prices)
    float maxDD = maximumDrawdown(prices)
    PriceSegment worst = na(maxDD) ? na : prices.worstRange
    bool developingMax = false
    PriceSegment active = dips.rising ? na : swingSegment(dips.origin, dips.extreme)
    bool developingActive = false
    if valid
        float reference = useWicks ? prices.wickPeak : math.max(nz(prices.peakClose, price), price)
        float endpoint = useWicks ? lo : price
        currentDD := useWicks ? wickDrawdown(lo, reference) : changePercent(price, reference)
        developingMax := not na(currentDD) and (useWicks or prices.validDays > 0) and (na(maxDD) or currentDD < maxDD)
        if developingMax
            maxDD := currentDD
            int referenceDay = useWicks ? prices.wickPeakDay : price > prices.peakClose ? sourceDay : prices.peakCloseDay
            worst := PriceSegment.new(na, reference, na, endpoint, referenceDay, sourceDay)
        developingActive := not na(active) and math.sign(endpoint - active.endPrice) < 0
        if developingActive
            active := PriceSegment.new(active.startTime, active.startPrice, sourceTime, endpoint, active.startDay, sourceDay, active.chartStart, chartLow)
    else if developing
        currentDD := na
    float activeDepth = not na(active) ? segmentDepth(active) : math.sign(dips.turnThreshold) == 1 and not na(dips.previousValidDay) ? 0.0 : na
    MarketPreview.new(developing ? sourceDay : prices.lastDay, developing, hasPending ? sourceDay : na,
         developing ? price : prices.lastClose, valid and useWicks ? lo : na, currentDD, maxDD, developingMax,
         activeDepth, developingActive, active, dips.maxDip, worst, dips.lastDip,
         prices.firstDrawdownDay, prices.activeFxGaps, developing ? sourceFx : prices.latestFx)

var PriceHistory chartPrices = newPriceHistory()
var array<float> thresholds = showCompare ? array.from(COMPARE_DIP_THRESHOLD) : array.from(dipFirst, dipSecond, dipThird, dipFourth)
var DipHistory chartDips = newDipHistory(thresholds.size())
var array<PriceSegment> chartDrawdowns = array.new<PriceSegment>()
var int chartPeakTime = na
var int chartPeakDay = na
var float chartPeakPrice = na
float chartDayHigh = useWicks ? high : close
float chartDayLow = useWicks ? low : close
int swingWeek = time("1W")
[developingDay, developingPrice, developingHigh, developingLow] = if comparisonPanel
    comparisonPrices(false)
else
    [time_tradingday, close, high, low]

if confirmedDay
    float metricClose = showCompare ? comparisonClose : confirmedClose
    float hi = showCompare ? comparisonHigh : high
    float lo = showCompare ? comparisonLow : low
    float priorWickPeak = chartPrices.wickPeak
    int priorWickPeakDay = chartPrices.wickPeakDay
    chartPrices.addClose(time_tradingday, metricClose, hi, lo, comparisonFxMissing, comparisonWickFxMissing, comparisonFx)
    if not showMaBehavior or swingMarksVisible
        PriceSegment leg = chartDips.observeDipDay(time_tradingday, time, swingWeek, metricClose, hi, lo, thresholds, chartDayHigh, chartDayLow)
        if swingMarksVisible
            drawCompletedSwing(leg, time)
        else if dipMarksVisible and (showCompare or orderedThresholds) and -segmentDepth(leg) >= thresholds.first()
            drawCompletedDip(leg)
    if rarityMarkVisible and not na(metricClose) and (not useWicks or validWicks(hi, lo))
        int latestPeakDay = useWicks ? chartPrices.wickPeakDay : chartPrices.peakCloseDay
        bool isPeak = latestPeakDay == time_tradingday
        if isPeak and not useWicks
            chartPeakTime := time
            chartPeakDay := time_tradingday
            chartPeakPrice := chartDayHigh
        // A rarity endpoint is always within this many calendar days of the anchor.
        int referenceDay = useWicks ? priorWickPeakDay : latestPeakDay
        if not na(referenceDay) and chartPeakDay == referenceDay
            if chartDrawdowns.size() >= OPPORTUNITY_LAG_DAYS + 1
                chartDrawdowns.shift()
            chartDrawdowns.push(PriceSegment.new(chartPeakTime, useWicks ? priorWickPeak : chartPrices.peakClose,
                 time, useWicks ? lo : metricClose, referenceDay, time_tradingday, chartPeakPrice, chartDayLow))
        if isPeak and useWicks
            chartPeakTime := time
            chartPeakDay := time_tradingday
            chartPeakPrice := chartDayHigh

consecutiveSma(float price, int length) =>
    // ta.sma skips na. The streak prevents its window from crossing an invalid bar.
    var int streak = 0
    streak := na(price) ? 0 : streak + 1
    float mean = ta.sma(price, length)
    streak >= length ? mean : na

completedSmas(int length) =>
    float mean = consecutiveSma(validPrice(close), length)
    [nz(mean[1]), nz(mean[2])]

smoothCompletedSma(float mean, float earlier, string period) =>
    float result = mean
    if smoothSma and not na(mean) and math.sign(earlier) == 1
        int periodStart = time(period)
        int periodEnd = time_close(period)
        if periodEnd > periodStart
            float progress = math.max(0.0, math.min(1.0, float(time_close - periodStart) / (periodEnd - periodStart)))
            result := earlier + progress * (mean - earlier)
    result

maForDailyClose(float dailyClose) =>
    float mean = consecutiveSma(dailyClose, smaLength)
    if smaTimeframe != "Daily"
        string requestedTimeframe = smaTimeframe == "Weekly" ? "1W" : "1M"
        // Compute in the daily context even when the chart itself is weekly or monthly.
        [completedSma, earlierSma] = request.security(syminfo.tickerid, requestedTimeframe, completedSmas(smaLength), lookahead = barmerge.lookahead_on)
        mean := smoothCompletedSma(validPrice(completedSma), earlierSma, requestedTimeframe)
    mean

compareSma(float price, bool converted) =>
    if not converted or smaTimeframe == "Daily"
        maForDailyClose(price)
    else
        string period = smaTimeframe == "Weekly" ? "1W" : "1M"
        bool newPeriod = timeframe.change(period) and not na(time(period)[1])
        // Take the already converted last daily close only after its period ends.
        float periodClose = newPeriod ? price[1] : na
        float average = ta.sma(periodClose, smaLength)
        var int streak = 0
        var float mean = na
        var float earlier = na
        if newPeriod
            streak := na(periodClose) ? 0 : streak + 1
            earlier := mean
            mean := streak >= smaLength ? average : na
        smoothCompletedSma(mean, earlier, period)

float smaForDay = supportedChart ? maForDailyClose(confirmedClose) : na

if not na(confirmedClose) and not na(smaForDay)
    comparableDays += 1
    if math.sign(confirmedClose - smaForDay) == 1
        aboveSmaDays += 1

yearsEarlier(int sessionDay, int yearsBack) =>
    int targetYear = year(sessionDay, SESSION_ZONE) - yearsBack
    int targetMonth = month(sessionDay, SESSION_ZONE)
    int targetDay = dayofmonth(sessionDay, SESSION_ZONE)
    bool leapYear = targetYear % 4 == 0 and (targetYear % 100 != 0 or targetYear % 400 == 0)
    if targetMonth == 2 and targetDay == 29 and not leapYear
        targetDay := 28
    timestamp(SESSION_ZONE, targetYear, targetMonth, targetDay, 0, 0)

type MaSample
    int day
    float value

type MaDistribution
    array<float> ordered
    array<MaSample> byDate

newMaDistribution() =>
    MaDistribution.new(array.new<float>(), array.new<MaSample>())

distanceBound(array<float> ordered, float value, bool inclusive) =>
    int first = 0
    int last = ordered.size()
    while first < last
        int mid = first + int((last - first) / 2)
        float direction = math.sign(ordered.get(mid) - value)
        if direction < 0 or (inclusive and direction == 0)
            first := mid + 1
        else
            last := mid
    first

upperBound(array<float> ordered, float value) =>
    distanceBound(ordered, value, true)

method includeSample(MaDistribution distribution, int day, float value, bool keepDates) =>
    int position = upperBound(distribution.ordered, value)
    if position == distribution.ordered.size()
        distribution.ordered.push(value)
    else
        distribution.ordered.insert(position, value)
    if keepDates
        distribution.byDate.push(MaSample.new(day, value))

method expireSamples(MaDistribution distribution, int cutoff) =>
    while distribution.byDate.size() > 0 and distribution.byDate.first().day < cutoff
        MaSample sample = distribution.byDate.shift()
        distribution.ordered.remove(distribution.ordered.binary_search(sample.value))

method maPercentile(MaDistribution distribution, int percentile, int minimum) =>
    int size = distribution.ordered.size()
    size >= minimum ? distribution.ordered.get(int(math.ceil(size * percentile / 100.0)) - 1) : na

method maMedian(MaDistribution distribution, int minimum) =>
    int size = distribution.ordered.size()
    size >= minimum ? (distribution.ordered.get(int((size - 1) / 2)) + distribution.ordered.get(int(size / 2))) / 2 : na

type MaHistory
    MaDistribution aboveDistances
    MaDistribution belowDistances
    MaDistribution aboveRuns
    MaDistribution belowRuns
    array<int> equalDays
    int equalCount = 0
    int firstComparable = na
    int lastDay = na
    int cutoff = na
    bool previousComparable = false
    int side = 0
    int runStart = na
    int runLength = 0
    bool runStartKnown = false
    float distance = na
    float stretch = na
    int extremeZone = 0
    int candleTail = 0
    int candleRun = 0
    int candleSide = 0

newMaHistory() =>
    MaHistory.new(newMaDistribution(), newMaDistribution(), newMaDistribution(), newMaDistribution(), array.new<int>())

method coversWindow(MaHistory history, int cutoff) =>
    not na(history.firstComparable) and (na(cutoff) or history.firstComparable <= cutoff)

method signedDistanceAt(MaHistory history, int index) =>
    int below = history.belowDistances.ordered.size()
    int nonpositive = below + history.equalCount
    index < below ? -history.belowDistances.ordered.get(below - index - 1) : index < nonpositive ? 0.0 : history.aboveDistances.ordered.get(index - nonpositive)

percentilePosition(int count, int percentile) =>
    (count - 1) * percentile / 100.0

method signedPercentile(MaHistory history, int percentile) =>
    int count = history.aboveDistances.ordered.size() + history.belowDistances.ordered.size() + history.equalCount
    float position = percentilePosition(count, percentile)
    int left = int(math.floor(position))
    float lower = history.signedDistanceAt(left)
    float upper = history.signedDistanceAt(int(math.ceil(position)))
    lower + (upper - lower) * (position - left)

method recordExtremeEntry(MaHistory history, int side, float distance, int cutoff, int percentile) =>
    int event = 0
    int zone = history.extremeZone
    bool covered = history.coversWindow(cutoff)
    bool aboveReady = covered and history.aboveDistances.ordered.size() >= MIN_MA_DISTANCES
    bool belowReady = covered and history.belowDistances.ordered.size() >= MIN_MA_DISTANCES
    int lowerTail = 100 - percentile
    if zone == 1 and (side <= 0 or (aboveReady and distance < history.signedPercentile(percentile - 5)))
        zone := 0
    else if zone == -1 and (side >= 0 or (belowReady and distance > history.signedPercentile(lowerTail + 5)))
        zone := 0
    if zone == 0
        if side > 0 and aboveReady and distance >= history.signedPercentile(percentile)
            event := 1
        else if side < 0 and belowReady and distance <= history.signedPercentile(lowerTail)
            event := -1
        zone := event
    history.extremeZone := zone
    event

method recordExtremeCandle(MaHistory history, int side, float distance, int cutoff, int percentile) =>
    int tail = 0
    if side != 0 and history.coversWindow(cutoff)
        int count = side > 0 ? history.aboveDistances.ordered.size() : history.belowDistances.ordered.size()
        if count >= MIN_MA_DISTANCES
            float boundary = history.signedPercentile(side > 0 ? percentile : 100 - percentile)
            if side > 0 ? distance >= boundary : distance <= boundary
                tail := side
    history.candleRun := tail == 0 ? 0 : tail == history.candleTail ? history.candleRun + 1 : 1
    history.candleTail := tail
    history.candleSide := history.candleRun <= 2 ? tail : 0

method observeMa(MaHistory history, int day, float price, float mean, int years, int percentile, bool assess, bool showStretch) =>
    int cutoff = years > 0 ? yearsEarlier(day, years) : na
    bool keepDates = not na(cutoff)
    if keepDates
        history.aboveDistances.expireSamples(cutoff)
        history.belowDistances.expireSamples(cutoff)
        history.aboveRuns.expireSamples(cutoff)
        history.belowRuns.expireSamples(cutoff)
        while history.equalDays.size() > 0 and history.equalDays.first() < cutoff
            history.equalDays.shift()
            history.equalCount -= 1

    bool comparable = not na(price) and not na(mean)
    int side = comparable ? int(math.sign(price - mean)) : 0
    float magnitude = comparable ? 100 * math.abs(price - mean) / mean : na
    int length = side == 0 ? 0 : side == history.side ? history.runLength + 1 : 1
    MaDistribution distances = side > 0 ? history.aboveDistances : history.belowDistances
    // Score against prior distances. A missing observation cannot rearm a zone.
    int event = assess and comparable ? history.recordExtremeEntry(side, side * magnitude, cutoff, percentile) : 0
    if colorExtremeCandles
        history.recordExtremeCandle(side, side * magnitude, cutoff, percentile)
    history.stretch := showStretch and side != 0 and history.coversWindow(cutoff) and distances.ordered.size() >= MIN_MA_DISTANCES ? 100.0 * upperBound(distances.ordered, magnitude) / distances.ordered.size() : na

    if side != history.side
        if comparable and history.runStartKnown and (not keepDates or history.runStart >= cutoff)
            MaDistribution closedRuns = history.side > 0 ? history.aboveRuns : history.belowRuns
            closedRuns.includeSample(history.runStart, history.runLength, keepDates)
        history.runStart := side == 0 ? na : day
        history.runStartKnown := side != 0 and history.previousComparable

    if comparable
        if na(history.firstComparable)
            history.firstComparable := day
        if side == 0
            history.equalCount += 1
            if keepDates
                history.equalDays.push(day)
        else
            distances.includeSample(day, magnitude, keepDates)
    history.lastDay := day
    history.cutoff := cutoff
    history.previousComparable := comparable
    history.side := side
    history.runLength := length
    history.distance := side * magnitude
    event

bool maBehaviorPanel = supportedMaChart and showMaBehavior
bool trackMaBehavior = supportedMaChart and (showMaBehavior or colorExtremeCandles or showExtremeEntries)
int maYears = maStatisticsPeriod == "5 Years" ? 5 : maStatisticsPeriod == "10 Years" ? 10 : 0

type MaSideSummary
    int sessions
    int runs
    float medianDistance
    float p90Distance
    float medianDuration
    float p90Duration

summarizeMaSide(MaDistribution distances, MaDistribution runs, bool covered) =>
    MaSideSummary.new(distances.ordered.size(), runs.ordered.size(), covered ? distances.maMedian(MIN_MA_DISTANCES) : na,
         covered ? distances.maPercentile(90, MIN_MA_DISTANCES) : na, covered ? runs.maMedian(MIN_MA_RUNS) : na, covered ? runs.maPercentile(90, MIN_MA_RUNS) : na)

type MaSummary
    MaSideSummary above
    MaSideSummary below
    int equalCount
    bool covered
    int startDay
    int endDay
    bool comparable
    int side
    int runLength
    bool runStartKnown
    float distance
    float stretch
    int event

method summarizeMa(MaHistory history, int event) =>
    bool covered = history.coversWindow(history.cutoff)
    int start = math.max(nz(history.cutoff, history.firstComparable), history.firstComparable)
    MaSummary.new(summarizeMaSide(history.aboveDistances, history.aboveRuns, covered), summarizeMaSide(history.belowDistances, history.belowRuns, covered),
         history.equalCount, covered, start, history.lastDay, history.previousComparable, history.side, history.runLength, history.runStartKnown, history.distance, history.stretch, event)

type DailyMaFrame
    int closesAt
    float finalPrice
    float mean
    bool sourceHistorical
    int eventAt
    int eventSide
    int candleAt
    int candleSide
    MaSummary summary

dailyMaFrame(float price, float mean, bool takeClose) =>
    var MaHistory history = trackMaBehavior ? newMaHistory() : na
    var DailyMaFrame frame = na
    var int eventAt = na
    var int eventSide = 0
    var int candleAt = na
    var int candleSide = 0
    if takeClose
        int event = trackMaBehavior ? history.observeMa(time_tradingday, price, mean, maYears, maExtremePercentile, true, showMaBehavior) : 0
        if event != 0
            eventAt := time_close
            eventSide := event
        if colorExtremeCandles and history.candleSide != 0
            candleAt := time_close
            candleSide := history.candleSide
        frame := DailyMaFrame.new(time_close, price, mean, barstate.ishistory, eventAt, eventSide,
             candleAt, candleSide, showMaBehavior ? history.summarizeMa(event) : na)
    frame

requestedDailyMa() =>
    float price = validPrice(close)
    DailyMaFrame frame = dailyMaFrame(price, maForDailyClose(price), true)
    // Only scalar results leave the daily context. The previous frame is final
    // even when the current source bar is still developing.
    [frame, frame[1]]

confirmedMaFrame(DailyMaFrame source, DailyMaFrame previous) =>
    int availableUntil = barstate.ishistory ? time_close : math.min(time_close, timenow)
    bool sourceElapsed = not na(source) and source.closesAt <= availableUntil
    // A simultaneous host close corroborates the daily close on the same feed.
    bool sameClose = sourceElapsed and barstate.isconfirmed and source.closesAt == time_close and math.sign(source.finalPrice - close) == 0
    sourceElapsed and (barstate.ishistory or source.sourceHistorical or sameClose) ? source : not na(previous) and previous.closesAt <= availableUntil ? previous : na

DailyMaFrame activeMa = na
if supportedChart
    activeMa := dailyMaFrame(confirmedClose, smaForDay, confirmedDay)
else if supportedMaChart and (showSma or trackMaBehavior)
    [source, previous] = request.security(syminfo.tickerid, "1D", requestedDailyMa(), lookahead = barmerge.lookahead_off)
    activeMa := confirmedMaFrame(source, previous)

float chartMa = na(activeMa) ? na : activeMa.mean
int confirmedThrough = na(activeMa) ? na : activeMa.closesAt
markOnChartBar(int markAt, int previouslyConfirmed) =>
    bool inside = not na(markAt) and markAt > time and markAt <= time_close
    bool late = timeframe.isintraday and not na(previouslyConfirmed) and not na(markAt) and markAt > previouslyConfirmed and markAt <= time
    inside or late

bool showEntry = showExtremeEntries and not na(activeMa) and markOnChartBar(activeMa.eventAt, confirmedThrough[1])
color extremeCandle = colorExtremeCandles and not na(activeMa) and markOnChartBar(activeMa.candleAt, confirmedThrough[1]) ?
     (activeMa.candleSide > 0 ? EXTREME_ABOVE_CANDLE : EXTREME_BELOW_CANDLE) : na
plot(showSma ? chartMa : na, "SMA", color = #609DB9, style = plot.style_linebr, display = display.pane + display.data_window)
// Draw only the flagged candles, at the chart's own OHLC coordinates.
plotcandle(not na(extremeCandle) ? open : na, high, low, close, "Extreme MA Candles", color = extremeCandle, wickcolor = extremeCandle, bordercolor = extremeCandle, editable = false, display = display.pane)
plotshape(showEntry and activeMa.eventSide > 0, "Upper MA extreme entry", shape.triangledown, location.abovebar, EXTREME_ABOVE_COLOR, size = size.tiny, editable = false, display = display.pane)
plotshape(showEntry and activeMa.eventSide < 0, "Lower MA extreme entry", shape.triangleup, location.belowbar, EXTREME_BELOW_COLOR, size = size.tiny, editable = false, display = display.pane)

referenceIndex(PriceHistory history, int target) =>
    int oldest = math.max(0, history.sessionCount - PERIOD_HISTORY_SIZE)
    int startIndex = oldest
    int endIndex = history.sessionCount
    // Search by chronological index and use modulo only when accessing storage.
    while startIndex < endIndex
        int mid = startIndex + int((endIndex - startIndex) / 2)
        if history.sessionDays.get(mid % PERIOD_HISTORY_SIZE) <= target
            startIndex := mid + 1
        else
            endIndex := mid
    startIndex > oldest ? startIndex - 1 : na

referenceAt(PriceHistory history, int target) =>
    int slot = referenceIndex(history, target) % PERIOD_HISTORY_SIZE
    // Keep invalid bars in the search so an unknown reference cannot be skipped.
    [na(slot) ? na : history.sessionDays.get(slot), na(slot) ? na : history.sessionCloses.get(slot)]

formatPercentNumber(float value) =>
    str.tostring(value, "0.00")

formatPercent(float value) =>
    na(value) ? MISSING_VALUE : formatPercentNumber(value) + "%"

formatMarketValue(string value, bool developing) =>
    developing and value != MISSING_VALUE ? "~" + value : value

formatDay(int day) =>
    na(day) ? "Unavailable" : str.format_time(day, "yyyy-MM-dd", SESSION_ZONE)

formatPeriod(int startDay, int endDay) =>
    not na(startDay) and startDay != endDay ? formatDay(startDay) + " – " + formatDay(endDay) : formatDay(endDay)

formatMarketPrice(MarketPreview market) =>
    if na(market) or na(market.price)
        MISSING_VALUE
    else
        string precision = market.price >= 1.0 ? "#,##0.00" : market.price >= 0.01 ? "0.0000" : "0.00000000"
        formatMarketValue(str.tostring(market.price, precision), market.developing)

marketPriceDetail(MarketPreview market) =>
    string detail = "Latest price in TradingView's daily series."
    if na(market) or na(market.price)
        detail += "\nPrice unavailable."
    else
        detail += "\n" + formatDay(market.day) + (market.developing ? " · ~ Unconfirmed" : " · Confirmed close") + " · " + str.tostring(market.price, "#,##0.00######")
        if not na(market.lowPrice)
            detail += "\nSession low " + str.tostring(market.lowPrice, "#,##0.00######")
    if not na(market) and not market.developing and not na(market.pendingDay)
        detail += "\nUnconfirmed price unavailable for " + formatDay(market.pendingDay) + "."
    if not na(market) and not na(market.fx)
        FxQuote quote = market.fx
        if not na(quote.stableCloseAt)
            detail += "\n" + quote.stablecoin + "/USD " + str.tostring(quote.stableUsd, "0.000000") + " · " + str.format_time(quote.stableCloseAt, "yyyy-MM-dd HH:mm", SESSION_ZONE) + " UTC"
        if not na(quote.targetCloseAt)
            detail += "\nUSD/" + quote.targetCurrency + " " + str.tostring(quote.usdTarget, "0.000000") + " · " + str.format_time(quote.targetCloseAt, "yyyy-MM-dd HH:mm", SESSION_ZONE) + " UTC"
    detail + "\nUpdates with the chart's feed. Exchange and FX feeds may be delayed."

currentDrawdownDetail() =>
    useWicks ? "Session low versus the highest high of earlier confirmed sessions. A rebound in the latest trade does not change the session low." : "Latest price versus the highest confirmed close or a new top at the latest price."

segmentDetail(PriceSegment leg) =>
    na(leg) ? "" : "\nPeak " + formatDay(leg.startDay) + " · " + str.tostring(leg.startPrice, "#,##0.00######") +
         "\nTrough " + formatDay(leg.endDay) + " · " + str.tostring(leg.endPrice, "#,##0.00######")

maxDrawdownDetail(MarketPreview market) =>
    "Deepest ATH drawdown over the loaded history. " + (useWicks ? "Session low versus an earlier high." : "Close versus highest close.") +
         " ~ marks a provisional new extreme." + (na(market) ? "" : "\nComparable since " + formatDay(market.drawdownStart) + segmentDetail(market.worstRange))

maxDipDetail(MarketPreview market) =>
    "Deepest completed structural decline from a confirmed local peak." + (na(market) ? "" : segmentDetail(market.maxDipLeg))

activeDipDetail(MarketPreview market) =>
    string detail = "Deepest point of the latest open structural decline. ~ marks a provisional lower point."
    if not na(market) and not na(market.activeLeg)
        detail += segmentDetail(market.activeLeg)
        detail += "\nLatest trade vs pivot: " + formatPercent(changePercent(market.price, market.activeLeg.startPrice))
        if not na(market.lowPrice)
            detail += " · Session low vs pivot: " + formatPercent(changePercent(market.lowPrice, market.activeLeg.startPrice))
    else if not na(market) and market.active == 0 and not na(market.lastDipLeg)
        detail += "\nLatest completed dip " + formatPercent(segmentDepth(market.lastDipLeg)) + segmentDetail(market.lastDipLeg)
    detail

band(table panel, int row, string heading, string tooltip = "") =>
    table.cell(panel, 0, row, heading, text_color = VALUE_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = SECTION_BG, tooltip = tooltip)

metricText(table panel, int column, int row, string label, string value, string tooltip) =>
    table.cell(panel, column, row, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = tooltip)
    table.cell(panel, column + 1, row, value, text_color = value == MISSING_VALUE ? MUTED_COLOR : VALUE_COLOR, text_halign = text.align_right, text_size = size.small, tooltip = tooltip)

metric(table panel, int column, int row, string label, float value, string tooltip) =>
    metricText(panel, column, row, label, formatPercent(value), tooltip)

periodMetric(table panel, int column, int row, int yearsBack, int endDay, float endClose, PriceHistory history) =>
    int target = na(endDay) ? na : yearsEarlier(endDay, yearsBack)
    [refDay, refClose] = referenceAt(history, target)
    string detail = na(refDay) ? "Insufficient loaded history." : na(refClose) ? "Invalid reference close on " + formatDay(refDay) + "." : "From " + formatDay(refDay) + " to " + formatDay(endDay) + "."
    if na(endClose) and not na(refClose)
        detail += " Latest confirmed close unavailable."
    metric(panel, column, row, str.tostring(yearsBack) + "Y", changePercent(endClose, refClose), detail)

dipRates(int count, int observedDays, int startDay) =>
    // An anniversary can be 365 or 366 days away. Use the same calendar
    // convention as period returns and require that many covered days.
    int yearDays = na(startDay) ? na : int((yearsEarlier(startDay, -1) - startDay) / MS_PER_DAY)
    bool enoughHistory = not na(yearDays) and observedDays >= yearDays
    float observedYears = observedDays / DAYS_PER_YEAR
    float perYear = enoughHistory ? count / observedYears : na
    float yearsPerDip = enoughHistory and count > 0 ? observedYears / count : na
    [perYear, yearsPerDip]

dipFrequencyText(int count, float perYear, float yearsPerDip) =>
    na(perYear) ? MISSING_VALUE : count == 0 ? "0" : perYear >= 1 ? str.tostring(perYear, "0.0") + "/y" : "1/" + str.tostring(yearsPerDip, "0.0") + "y"

dipMetric(table panel, int row, float threshold, int count, int observedDays, int startDay, string coverage) =>
    [perYear, yearsPerDip] = dipRates(count, observedDays, startDay)
    string detail = str.tostring(count) + " completed dips at or above this threshold."
    detail += "\n" + coverage
    if na(perYear)
        detail += "\nAt least one calendar year of observed coverage is required for annualized rates."
    else
        detail += "\nPer year: " + str.tostring(perYear, "0.00")
        if count > 0
            detail += " · Years per dip: " + str.tostring(yearsPerDip, "0.00")
    detail += "\nObserved frequency."
    metricText(panel, 0, row, "≥" + str.tostring(threshold) + "%", dipFrequencyText(count, perYear, yearsPerDip), detail)

// A shared calendar target stays constant throughout historical execution.
// Keep its predecessor as bars arrive and re-search only if the target moves.
referenceForAnchor(PriceHistory history, int target) =>
    var int cachedTarget = na
    var int referenceDay = na
    var float referenceClose = na
    if na(cachedTarget) or target != cachedTarget
        [day, price] = referenceAt(history, target)
        referenceDay := day
        referenceClose := price
        cachedTarget := target
    else if not na(history.lastDay) and history.lastDay <= target
        referenceDay := history.lastDay
        referenceClose := history.lastClose
    [referenceDay, referenceClose]

int comparisonAnchor = int(timenow / MS_PER_DAY) * MS_PER_DAY
int oneYearTarget = yearsEarlier(comparisonAnchor, 1)
int threeYearTarget = yearsEarlier(comparisonAnchor, 3)
int fiveYearTarget = yearsEarlier(comparisonAnchor, 5)

periodCagr(int start, float initial, int finish, float finalPrice) =>
    float years = (finish - start) / MS_PER_DAY / DAYS_PER_YEAR
    years > 0 ? 100 * (math.pow(finalPrice / initial, 1.0 / years) - 1) : na

opportunityIndex(float quality, float currentDD) =>
    float discount = -currentDD
    quality > 0 and discount > 0 and discount < 100 ? quality * discount / (100 - discount) : na

type ComparisonSnapshot
    int cutoff
    int endDay
    int ref3
    int ref5
    float quality
    float drawdown
    float score
    int rarityCount
    int rarityDays

recentSession(int day, int target) =>
    not na(day) and day <= target and day >= target - OPPORTUNITY_LAG_DAYS * MS_PER_DAY

type MaComparison
    int day
    float distance
    float percentile = na
    int extreme = 0
    int firstPriorDay = na
    int lastPriorDay = na
    int priorCount = 0
    int sideCount = 0
    bool covered = false

type CompareMaHistory
    array<int> days
    array<float> distances
    array<MaComparison> recent

newCompareMaHistory() =>
    CompareMaHistory.new(array.new<int>(), array.new<float>(), array.new<MaComparison>())

sortedPercentile(array<float> ordered, int percentile) =>
    float position = percentilePosition(ordered.size(), percentile)
    int left = int(math.floor(position))
    float lower = ordered.get(left)
    lower + (ordered.get(int(math.ceil(position))) - lower) * (position - left)

signedPercentileRank(array<float> ordered, float distance) =>
    int left = distanceBound(ordered, distance, false)
    int right = upperBound(ordered, distance)
    float position = 0.0
    if left < right
        position := (left + right - 1) / 2.0
    else if left == ordered.size()
        position := left - 1
    else if left > 0
        float lower = ordered.get(left - 1)
        position := left - 1 + (distance - lower) / (ordered.get(left) - lower)
    100.0 * position / (ordered.size() - 1)

method addMaClose(CompareMaHistory history, int day, float price, float mean, bool finalRecord = false) =>
    float distance = 100 * (price - mean) / mean
    if recentSession(day, comparisonAnchor) or finalRecord
        MaComparison snapshot = MaComparison.new(day, distance)
        int count = history.days.size()
        int cutoff = maYears > 0 ? yearsEarlier(day, maYears) : na
        if count > 0
            int first = history.days.first()
            snapshot.covered := na(cutoff) or first <= cutoff
            int index = na(cutoff) or first >= cutoff ? 0 : history.days.last() < cutoff ? count : history.days.binary_search_rightmost(cutoff)
            snapshot.priorCount := count - index
            if snapshot.priorCount > 0
                snapshot.firstPriorDay := history.days.get(index)
                snapshot.lastPriorDay := history.days.last()
            // Sort a copy only for recent endpoints, before adding today's close.
            if snapshot.covered and snapshot.priorCount >= MIN_MA_DISTANCES and not na(distance)
                array<float> sorted = history.distances.slice(index, count).copy()
                sorted.sort()
                int side = int(math.sign(distance))
                snapshot.sideCount := side > 0 ? sorted.size() - upperBound(sorted, 0.0) : side < 0 ? distanceBound(sorted, 0.0, false) : sorted.size()
                if snapshot.sideCount >= MIN_MA_DISTANCES
                    snapshot.percentile := signedPercentileRank(sorted, distance)
                    if side > 0 and distance >= sortedPercentile(sorted, maExtremePercentile)
                        snapshot.extreme := 1
                    else if side < 0 and distance <= sortedPercentile(sorted, 100 - maExtremePercentile)
                        snapshot.extreme := -1
        if history.recent.size() == OPPORTUNITY_LAG_DAYS + 1
            history.recent.shift()
        history.recent.push(snapshot)
    if not na(distance)
        history.days.push(day)
        history.distances.push(distance)

dipRarityCounts(array<float> drawdowns, int startIndex, int endIndex, float cutoffDrawdown) =>
    int deep = 0
    int days = endIndex - startIndex + 1
    for index = startIndex to endIndex
        float drawdown = drawdowns.get(index % PERIOD_HISTORY_SIZE)
        if na(drawdown)
            // An explicit invalid bar leaves the five-year distribution uncertain.
            days := na
            deep := na
            break
        if drawdown <= cutoffDrawdown
            deep += 1
    [deep, days]

comparisonAt(PriceHistory prices, int cutoff) =>
    ComparisonSnapshot snapshot = na
    int endIndex = referenceIndex(prices, cutoff)
    if not na(endIndex)
        int endSlot = endIndex % PERIOD_HISTORY_SIZE
        int endDay = prices.sessionDays.get(endSlot)
        float endPrice = prices.sessionCloses.get(endSlot)
        if recentSession(endDay, cutoff) and not na(endPrice)
            int target3 = yearsEarlier(cutoff, 3)
            int target5 = yearsEarlier(cutoff, 5)
            [ref3, price3] = referenceAt(prices, target3)
            int ref5Index = referenceIndex(prices, target5)
            if not na(ref5Index)
                int ref5Slot = ref5Index % PERIOD_HISTORY_SIZE
                int ref5 = prices.sessionDays.get(ref5Slot)
                float price5 = prices.sessionCloses.get(ref5Slot)
                if recentSession(ref5, target5) and not na(price5)
                    array<float> drawdowns = useWicks ? prices.wickDrawdowns : prices.sessionDrawdowns
                    float drawdown = drawdowns.get(endSlot)
                    float quality = recentSession(ref3, target3) ? 0.7 * periodCagr(ref3, price3, endDay, endPrice) + 0.3 * periodCagr(ref5, price5, endDay, endPrice) : na
                    float score = prices.firstDrawdownDay <= ref5 ? opportunityIndex(quality, drawdown) : na
                    // The predecessor verifies the boundary. Count it only when it is in the window.
                    int startIndex = ref5 == target5 ? ref5Index : ref5Index + 1
                    [deep, days] = if not na(drawdown) and not na(drawdowns.get(ref5Slot))
                        dipRarityCounts(drawdowns, startIndex, endIndex, drawdown)
                    else
                        [int(na), int(na)]
                    if not na(score) or not na(days)
                        snapshot := ComparisonSnapshot.new(cutoff, endDay, ref3, ref5, quality, drawdown, score, deep, days)
    snapshot

recentComparisons(PriceHistory prices, int anchor) =>
    array<ComparisonSnapshot> snapshots = na
    if recentSession(prices.lastDay, anchor)
        snapshots := array.new<ComparisonSnapshot>()
        // Transfer only this bounded set, and only near the latest session.
        for offset = 0 to OPPORTUNITY_LAG_DAYS
            int cutoff = anchor - offset * MS_PER_DAY
            if cutoff <= prices.lastDay
                ComparisonSnapshot snapshot = comparisonAt(prices, cutoff)
                if not na(snapshot) and recentSession(snapshot.endDay, anchor)
                    snapshots.push(snapshot)
    snapshots

cachedComparisons(PriceHistory prices, int anchor) =>
    var int cachedDay = na
    var int cachedAnchor = na
    var array<ComparisonSnapshot> snapshots = na
    if not na(prices.lastDay) and (na(cachedDay) or cachedDay != prices.lastDay or cachedAnchor != anchor)
        snapshots := recentComparisons(prices, anchor)
        cachedDay := prices.lastDay
        cachedAnchor := anchor
    snapshots

comparisonMetrics(PriceHistory prices, DipHistory dips, CompareMaHistory ma, int oneYear, int threeYears, int fiveYears, string quoteCurrency) =>
    [ref1, close1] = referenceForAnchor(prices, oneYear)
    [ref3, close3] = referenceForAnchor(prices, threeYears)
    [ref5, close5] = referenceForAnchor(prices, fiveYears)
    int count = dips.counts.get(0)
    [rate, interval] = dipRates(count, dips.observedDays, dips.everReady ? dips.firstValidDay : na)
    bool history3 = prices.lastDay > threeYears
    bool history5 = prices.lastDay > fiveYears
    // Price and dip histories stay in their own context.
    [quoteCurrency, prices.firstDay, prices.lastDay, ref1, ref3, ref5,
     count, dips.observedDays, dips.invalidBars, prices.missingFx,
     annualizedReturn(prices), prices.lastDay > oneYear ? changePercent(prices.lastClose, close1) : na,
     history3 ? changePercent(prices.lastClose, close3) : na, history5 ? changePercent(prices.lastClose, close5) : na,
     rate, interval,
     history3 ? periodCagr(ref3, close3, prices.lastDay, prices.lastClose) : na,
     history5 ? periodCagr(ref5, close5, prices.lastDay, prices.lastClose) : na, cachedComparisons(prices, comparisonAnchor),
     ma.recent.size() > 0 ? ma.recent : na]

remoteComparison(int oneYear, int threeYears, int fiveYears, float price, float hi, float lo) =>
    var PriceHistory prices = newPriceHistory()
    var DipHistory dips = newDipHistory(1)
    var CompareMaHistory ma = newCompareMaHistory()
    var array<float> levels = array.from(COMPARE_DIP_THRESHOLD)
    float mean = compareSma(price, comparisonUsesOwnPrices)
    int week = time("1W")
    // The previous native bar is final even during a delayed feed's open bar.
    // Include the current native bar only if historical and past its own close.
    int previousDay = time_tradingday[1]
    if not na(previousDay) and (na(prices.lastDay) or prices.lastDay < previousDay)
        prices.addClose(previousDay, price[1], hi[1], lo[1], comparisonFxMissing[1], comparisonWickFxMissing[1], comparisonFx[1])
        dips.observeDipDay(previousDay, time[1], week[1], price[1], hi[1], lo[1], levels)
        ma.addMaClose(previousDay, price[1], mean[1], barstate.islast)
    if barstate.ishistory and time_close <= timenow and (na(prices.lastDay) or prices.lastDay < time_tradingday)
        prices.addClose(time_tradingday, price, hi, lo, comparisonFxMissing, comparisonWickFxMissing, comparisonFx)
        dips.observeDipDay(time_tradingday, time, week, price, hi, lo, levels)
        ma.addMaClose(time_tradingday, price, mean, barstate.islast)
    [liveDay, livePrice, liveHigh, liveLow] = comparisonPrices(false)
    MarketPreview preview = marketPreview(prices, dips, time_tradingday, time, liveDay == time_tradingday ? livePrice : na, liveHigh, liveLow, true, comparisonFx)
    [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, incompleteFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots] =
         comparisonMetrics(prices, dips, ma, oneYear, threeYears, fiveYears, comparisonCurrency)
    [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, incompleteFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots, preview]

const int ROW_CAGR = 0
const int ROW_1Y = 1
const int ROW_3Y = 2
const int ROW_5Y = 3
const int ROW_CURRENT_DD = 4
const int ROW_MAX_DD = 5
const int ROW_MAX_DIP = 6
const int ROW_ACTIVE_DIP = 7
const int ROW_DIPS = 8
const int ROW_RARITY = 9
const int ROW_MA_DISTANCE = 10
const int ROW_MA_PERCENTILE = 11

type ComparisonColumn
    string tickerId
    string currency
    int firstDay
    int lastDay
    int ref1
    int ref3
    int ref5
    int dipCount
    int observedDays
    int invalidBars
    bool missingFx
    float yearsPerDip
    float cagr3
    float cagr5
    float quality
    array<float> values
    array<ComparisonSnapshot> snapshots
    array<MaComparison> maSnapshots
    MarketPreview market

comparisonColumn(string symbol, string quoteCurrency, int start, int finish, int ref1, int ref3, int ref5, int dipCount, int observed, int invalid, bool missingFx, float cagr, float ret1, float ret3, float ret5, float rate, float interval, float cagr3, float cagr5, array<ComparisonSnapshot> snapshots, array<MaComparison> maSnapshots, MarketPreview market) =>
    float quality = missingFx ? na : 0.7 * cagr3 + 0.3 * cagr5
    array<float> values = na(market) ? array.new<float>(ROW_DIPS + 1) : array.from(cagr, ret1, ret3, ret5, market.currentDD, market.maxDD, segmentDepth(market.maxDipLeg), market.active, rate)
    ComparisonColumn.new(symbol, quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, interval, cagr3, cagr5, quality, values, snapshots, maSnapshots, market)

canonicalSymbol(string tickerId) =>
    str.replace_all(ticker.standard(tickerId), "_DLY:", ":")

var array<string> extraSymbols = array.new<string>()
var array<ComparisonColumn> columns = array.new<ComparisonColumn>()
MarketPreview chartMarket = barstate.islast and supportedChart ? marketPreview(chartPrices, chartDips, time_tradingday, time,
     developingDay == time_tradingday ? developingPrice : na, developingHigh, developingLow, barstate.isrealtime and not barstate.isconfirmed, comparisonFx, chartDayLow) : na
if comparisonPanel
    var CompareMaHistory ma = newCompareMaHistory()
    float mean = comparisonUsesOwnPrices ? compareSma(comparisonClose, true) : smaForDay
    if confirmedDay
        ma.addMaClose(time_tradingday, comparisonClose, mean, barstate.islast)
    if barstate.isfirst
        array<string> symbols = array.from(symbolA, symbolB, symbolC, symbolD)
        array<bool> enabled = array.from(includeA, includeB, includeC, includeD)
        string chartSymbol = canonicalSymbol(syminfo.tickerid)
        for [index, symbol] in symbols
            string standardSymbol = canonicalSymbol(symbol)
            if enabled.get(index) and symbol != "" and standardSymbol != chartSymbol and not extraSymbols.includes(standardSymbol)
                extraSymbols.push(standardSymbol)
    [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots] = comparisonMetrics(chartPrices, chartDips, ma, oneYearTarget, threeYearTarget, fiveYearTarget, comparisonCurrency)
    if barstate.islast
        columns.clear()
        columns.push(comparisonColumn(canonicalSymbol(syminfo.tickerid), quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots, chartMarket))
if comparisonPanel
    for symbol in extraSymbols
        [quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots, market] = request.security(symbol, "1D",
             remoteComparison(oneYearTarget, threeYearTarget, fiveYearTarget, comparisonClose, comparisonHigh, comparisonLow),
             lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
        if barstate.islast
            columns.push(comparisonColumn(symbol, quoteCurrency, start, finish, ref1, ref3, ref5, dipCount, observed, invalid, missingFx, cagr, ret1, ret3, ret5, rate, interval, cagr3, cagr5, opportunities, maSnapshots, market))

comparisonStart(ComparisonColumn asset, int row) =>
    switch row
        ROW_1Y => asset.ref1
        ROW_3Y => asset.ref3
        ROW_5Y => asset.ref5
        ROW_MAX_DD => na(asset.market) ? na : asset.market.drawdownStart
        => asset.firstDay

validComparisonCurrency(string quoteCurrency) =>
    not na(quoteCurrency) and quoteCurrency != "" and quoteCurrency != "NONE"

sameComparisonCurrency(ComparisonColumn left, ComparisonColumn right) =>
    validComparisonCurrency(left.currency) and left.currency == right.currency

rankedValue(ComparisonColumn asset, int row) =>
    float value = asset.values.get(row)
    if row == ROW_CURRENT_DD
        MarketPreview market = asset.market
        bool comparable = not na(value) and asset.quality > 0 and not na(market) and recentSession(market.day, comparisonAnchor) and
             (na(market.pendingDay) or market.pendingDay == market.day)
        comparable ? -str.tonumber(formatPercentNumber(value)) : na
    else
        bool comparable = row != ROW_MAX_DD or (not na(asset.market) and not asset.market.developing and na(asset.market.pendingDay) and
             not (useWicks and asset.invalidBars > 0))
        comparable ? math.round(value, 2) : na

comparisonColor(array<ComparisonColumn> assets, ComparisonColumn asset, int row) =>
    float value = asset.values.get(row)
    color result = na(value) ? MUTED_COLOR : VALUE_COLOR
    float rank = rankedValue(asset, row)
    if not na(rank) and row <= ROW_MAX_DD
        bool currentDrawdownRow = row == ROW_CURRENT_DD
        int sessionDay = currentDrawdownRow ? asset.market.day : asset.lastDay
        int start = comparisonStart(asset, row)
        float lowest = rank
        float highest = rank
        bool newerSession = false
        for other in assets
            float otherRank = rankedValue(other, row)
            if not na(otherRank) and sameComparisonCurrency(asset, other)
                int otherDay = currentDrawdownRow ? other.market.day : other.lastDay
                if currentDrawdownRow and otherDay > sessionDay
                    newerSession := true
                    break
                if otherDay == sessionDay and (currentDrawdownRow or start == comparisonStart(other, row))
                    lowest := math.min(lowest, otherRank)
                    highest := math.max(highest, otherRank)
        if not newerSession and lowest < highest
            result := rank == lowest ? LOW_COLOR : rank == highest ? BEST_COLOR : VALUE_COLOR
    result

comparisonForCutoff(ComparisonColumn asset, int cutoff) =>
    ComparisonSnapshot selected = na
    if not na(asset.snapshots) and not na(cutoff)
        for snapshot in asset.snapshots
            if snapshot.cutoff == cutoff
                selected := snapshot
                break
    selected

opportunityForCutoff(ComparisonColumn asset, int cutoff) =>
    ComparisonSnapshot snapshot = comparisonForCutoff(asset, cutoff)
    not na(snapshot) and not na(snapshot.score) ? snapshot : na

eligibleOpportunity(ComparisonColumn asset, int anchor) =>
    not asset.missingFx and recentSession(asset.lastDay, anchor) and not na(opportunityForCutoff(asset, asset.lastDay))

type OpportunityGroup
    int cutoff = na
    int count = 0
    float lowest = na
    float highest = na
    int highestCount = 0

opportunityGroup(array<ComparisonColumn> assets, string quoteCurrency, int anchor) =>
    OpportunityGroup best = OpportunityGroup.new()
    for offset = 0 to OPPORTUNITY_LAG_DAYS
        int cutoff = anchor - offset * MS_PER_DAY
        OpportunityGroup candidate = OpportunityGroup.new(cutoff)
        for asset in assets
            // A fresh qualified close at or after the cutoff verifies coverage.
            if asset.currency == quoteCurrency and asset.lastDay >= cutoff and eligibleOpportunity(asset, anchor)
                ComparisonSnapshot snapshot = opportunityForCutoff(asset, cutoff)
                if not na(snapshot)
                    float rounded = math.round(snapshot.score, OPPORTUNITY_DECIMALS)
                    candidate.count += 1
                    candidate.lowest := math.min(nz(candidate.lowest, rounded), rounded)
                    if na(candidate.highest) or rounded > candidate.highest
                        candidate.highest := rounded
                        candidate.highestCount := 1
                    else if rounded == candidate.highest
                        candidate.highestCount += 1
        // Prefer the most participants, then the latest cutoff. Scores never choose the date.
        if candidate.count > best.count
            best := candidate
    best

opportunityGroups(array<ComparisonColumn> assets, int anchor) =>
    map<string, OpportunityGroup> groups = map.new<string, OpportunityGroup>()
    int comparableGroups = 0
    for asset in assets
        if validComparisonCurrency(asset.currency) and not groups.contains(asset.currency)
            OpportunityGroup group = opportunityGroup(assets, asset.currency, anchor)
            groups.put(asset.currency, group)
            if group.count >= 2
                comparableGroups += 1
    [groups, comparableGroups]

sharesOpportunityLead(OpportunityGroup group, ComparisonSnapshot snapshot, int comparableGroups) =>
    comparableGroups == 1 and not na(snapshot) and group.count >= 2 and
         math.round(snapshot.score, OPPORTUNITY_DECIMALS) == group.highest

opportunityColor(OpportunityGroup group, ComparisonSnapshot snapshot) =>
    color result = na(snapshot) ? MUTED_COLOR : VALUE_COLOR
    if not na(snapshot) and group.count >= 2 and group.lowest < group.highest
        float rounded = math.round(snapshot.score, OPPORTUNITY_DECIMALS)
        result := rounded == group.highest ? BEST_COLOR : rounded == group.lowest ? LOW_COLOR : VALUE_COLOR
    result

opportunityDetail(ComparisonColumn asset, OpportunityGroup group, ComparisonSnapshot snapshot, int comparableGroups, bool ranked) =>
    string detail = "Historical heuristic · Quality (70% 3Y CAGR + 30% 5Y CAGR) × recovery upside from the confirmed " + (useWicks ? "session low to the prior ATH high." : "close to the ATH close.")
    if na(snapshot)
        string reason = asset.missingFx ? "Latest confirmed close unavailable in " + asset.currency + "." : na(asset.cagr3) ? "A valid 3Y closing reference is required." :
             na(asset.cagr5) ? "A valid 5Y closing reference is required." :
             not recentSession(asset.lastDay, comparisonAnchor) ? "No confirmed close within the last four calendar days." :
             "Requires positive Quality, a drawdown and continuous FX coverage of the five-year comparison."
        detail += "\n" + reason
        detail += "\nLoaded history: " + formatPeriod(asset.firstDay, asset.lastDay) + "."
    else
        detail += "\nAs of " + formatDay(snapshot.cutoff) + " · " + asset.currency + " · Session " + formatDay(snapshot.endDay)
        detail += "\nReferences: " + formatDay(snapshot.ref3) + " (3Y) · " + formatDay(snapshot.ref5) + " (5Y)"
        detail += "\nQuality " + formatPercent(snapshot.quality) + " · DD " + formatPercent(snapshot.drawdown)
        if not ranked
            detail += "\nCalculated at this symbol's own date. Outside the shared ranking."
        else if group.count < 2
            detail += "\nAt least two comparable candidates are required."
        else if comparableGroups > 1
            detail += "\nColors compare within currency. Multiple groups have eligible candidates."
        else if group.highestCount > 1 and sharesOpportunityLead(group, snapshot, comparableGroups)
            detail += "\nShared highest displayed score."
    detail

comparisonDetail(ComparisonColumn asset, int row) =>
    string dates = "Loaded history: " + formatPeriod(asset.firstDay, asset.lastDay) + "."
    if not na(asset.market) and asset.market.fxGaps > 0
        dates += "\n" + str.tostring(asset.market.fxGaps) + " sessions missing required " + asset.currency + " data. Endpoints and coverage are checked per metric."
    string detail = switch row
        ROW_1Y => "Reference " + formatDay(asset.ref1) + " · Shared target " + formatDay(oneYearTarget) + "."
        ROW_3Y => "Reference " + formatDay(asset.ref3) + " · Shared target " + formatDay(threeYearTarget) + ".\n3Y CAGR: " + formatPercent(asset.missingFx ? na : asset.cagr3) + "."
        ROW_5Y => "Reference " + formatDay(asset.ref5) + " · Shared target " + formatDay(fiveYearTarget) + ".\n5Y CAGR: " + formatPercent(asset.missingFx ? na : asset.cagr5) + "."
        ROW_CURRENT_DD => currentDrawdownDetail() + " Colors compare the displayed values at two decimals, including ~, for the latest comparable session in this currency. Positive Quality required. Deeper ranks higher." +
             (na(asset.market) ? "" : "\nComparable since " + formatDay(asset.market.drawdownStart))
        ROW_MAX_DD => maxDrawdownDetail(asset.missingFx ? na : asset.market) + "\nCloser to zero ranks higher when comparable."
        ROW_MAX_DIP => maxDipDetail(asset.missingFx ? na : asset.market)
        ROW_ACTIVE_DIP => activeDipDetail(asset.missingFx ? na : asset.market)
        ROW_DIPS => na(asset.dipCount) ? "Daily history unavailable." : str.tostring(asset.dipCount) + " completed structural dips ≥10% · " + str.tostring(asset.observedDays, "#,##0") + " observed calendar days." + (useWicks ? "\nWicks" : "\nClose")
        => "Annualized price return using elapsed calendar days."
    if row >= ROW_1Y and row <= ROW_5Y
        detail += "\nLatest confirmed: " + formatDay(asset.lastDay) + " · Shared end target: " + formatDay(comparisonAnchor) + "."
        if na(asset.values.get(row))
            int reference = comparisonStart(asset, row)
            detail += na(reference) ? "\nLoaded history does not reach the target start." :
                 "\nA valid confirmed close is required at both endpoints."
    if row == ROW_CAGR and na(asset.values.get(row))
        detail += "\nRequires two valid closes in the covered segment."
    if row == ROW_MAX_DIP and na(asset.values.get(row))
        detail += "\nNo completed structural decline in the covered history."
    if row == ROW_ACTIVE_DIP and na(asset.values.get(row))
        detail += "\nRequires a valid current observation and 52 completed weeks of usable ranges."
    if row == ROW_CURRENT_DD or row == ROW_MAX_DD or row == ROW_ACTIVE_DIP
        detail += "\n" + marketPriceDetail(asset.market)
    if row == ROW_DIPS and not na(asset.dipCount) and not asset.missingFx
        if asset.invalidBars > 0
            detail += "\n" + str.tostring(asset.invalidBars) + " invalid sessions break episode coverage."
        if na(asset.values.get(row))
            detail += "\nAt least 52 completed weeks of valid ranges are required."
        detail += "\nObserved frequency."
    detail + "\n" + dates

formatOpportunity(float value) =>
    float rounded = math.round(value, OPPORTUNITY_DECIMALS)
    na(rounded) ? MISSING_VALUE : rounded == 0 ? "<0.01" : str.tostring(rounded, "0.00")

hasDipRarity(ComparisonSnapshot snapshot) =>
    not na(snapshot) and not na(snapshot.rarityDays)

dipRarityCutoff(array<ComparisonColumn> assets, string quoteCurrency, int opportunityCutoff, int anchor) =>
    int selected = opportunityCutoff
    // A group can have valid rarity even when every Opportunity score is unavailable.
    if na(opportunityCutoff)
        int mostCovered = 0
        for offset = 0 to OPPORTUNITY_LAG_DAYS
            int cutoff = anchor - offset * MS_PER_DAY
            int covered = 0
            for asset in assets
                if asset.currency == quoteCurrency and hasDipRarity(comparisonForCutoff(asset, cutoff))
                    covered += 1
            if covered > mostCovered
                selected := cutoff
                mostCovered := covered
    selected

formatDipRarity(int count, int days) =>
    str.tostring(100.0 * (1.0 - float(count) / days), "0.0") + "%"

dipRarityDetail(ComparisonSnapshot snapshot, int cutoff, bool missingFx) =>
    string detail = useWicks ? "Share of shallower daily drawdowns from a prior high to today's low." : "Share of daily closing drawdowns shallower than the cutoff drawdown."
    if not na(cutoff)
        detail += "\nFrom " + formatDay(yearsEarlier(cutoff, 5)) + " · As of " + formatDay(cutoff)
    if hasDipRarity(snapshot)
        detail += "\n" + str.tostring(snapshot.rarityCount, "#,##0") + " of " + str.tostring(snapshot.rarityDays, "#,##0") + " sessions at least as deep."
        if snapshot.endDay != cutoff
            detail += " Last session: " + formatDay(snapshot.endDay) + "."
    else
        detail += missingFx ? "\nCurrency conversion incomplete." : "\nValid five-year coverage and a confirmed close near the cutoff are required."
    detail

drawPriceReference(PriceSegment segmentPrices, string value, string detail, color ink, string lineStyle, string labelStyle, bool showLine = true) =>
    var line segment = na
    var label tag = na
    if not hasChartAnchors(segmentPrices)
        line.delete(segment)
        label.delete(tag)
        segment := na
        tag := na
    else
        if na(segment)
            segment := line.new(segmentPrices.startTime, segmentPrices.chartStart, segmentPrices.endTime, segmentPrices.chartEnd, xloc = xloc.bar_time, color = ink, style = lineStyle)
            tag := label.new(segmentPrices.endTime, segmentPrices.chartEnd, xloc = xloc.bar_time, style = labelStyle,
                 color = color.new(PANEL_BG, 15), textcolor = ink, size = size.tiny)
        else
            line.set_xy1(segment, segmentPrices.startTime, segmentPrices.chartStart)
            line.set_xy2(segment, segmentPrices.endTime, segmentPrices.chartEnd)
            label.set_xy(tag, segmentPrices.endTime, segmentPrices.chartEnd)
            label.set_style(tag, labelStyle)
            label.set_textcolor(tag, ink)
        line.set_color(segment, showLine ? ink : color.new(ink, 100))
        label.set_text(tag, value)
        label.set_tooltip(tag, detail)
    tag

drawActiveDip(MarketPreview market) =>
    string detail = activeDipDetail(market) + "\nMeasured in " + chartMeasureCurrency + chartAnchorDetail(market.activeLeg) + "\n" + marketPriceDetail(market)
    drawPriceReference(market.activeLeg, "Active " + formatMarketValue(formatPercent(market.active), market.developingActive), detail, ACTIVE_DIP_COLOR, line.style_dashed, label.style_label_right)

drawActiveSwing(PriceSegment leg, bool rising, bool developing = false) =>
    string move = na(leg) ? "" : (developing ? "~" : "") + formatSwingLeg(segmentDepth(leg))
    string rule = rising ? "Ongoing rise · The peak can move until the next confirmed turn." :
         "Ongoing decline · The trough can move until the next confirmed turn." + (developing ? "\nLowest point is provisional." : "")
    string detail = na(leg) ? "" : rule + "\n" + swingLegDetail(leg)
    drawPriceReference(leg, move, detail, rising ? SWING_UP_COLOR : SWING_DOWN_COLOR, line.style_dashed, rising ? label.style_label_down : label.style_label_up)

drawRarityDip(ComparisonSnapshot snapshot, string detail) =>
    PriceSegment dip = na
    string value = ""
    string tip = detail
    if hasDipRarity(snapshot)
        for mark in chartDrawdowns
            if mark.endDay == snapshot.endDay
                dip := mark
                value := "Rarity " + formatDipRarity(snapshot.rarityCount, snapshot.rarityDays)
                tip += "\nATH " + formatDay(dip.startDay) + " · " + str.tostring(dip.startPrice, format.mintick)
                tip += "\n" + (useWicks ? "Low " : "Close ") + formatDay(dip.endDay) + " · " + str.tostring(dip.endPrice, format.mintick)
                tip += " · DD " + formatPercent(snapshot.drawdown) + " · " + chartMeasureCurrency + chartAnchorDetail(dip)
                break
    drawPriceReference(dip, value, tip, RARITY_DIP_COLOR, line.style_dotted, label.style_label_up, not na(snapshot) and snapshot.drawdown < 0)

maComparisonForCutoff(ComparisonColumn asset, int cutoff) =>
    MaComparison selected = na
    int asOf = na
    if not na(asset.maSnapshots) and asset.maSnapshots.size() > 0
        if not na(cutoff) and asset.lastDay >= cutoff
            for snapshot in asset.maSnapshots
                if snapshot.day > cutoff
                    break
                if recentSession(snapshot.day, cutoff)
                    selected := snapshot
                    asOf := cutoff
        MaComparison latest = asset.maSnapshots.last()
        if na(selected) or (na(selected.distance) and not na(latest.distance))
            selected := latest
            asOf := latest.day
    [selected, asOf]

maComparisonDetail(ComparisonColumn asset, MaComparison snapshot, int cutoff, int sharedCutoff, bool chartSymbol) =>
    string period = maYears == 0 ? "All available" : str.tostring(maYears) + " years"
    string detail = "SMA " + str.tostring(smaLength) + " " + smaTimeframe + (smoothSma and smaTimeframe != "Daily" ? " · Smooth" : "")
    detail += na(asset.currency) ? "" : " · " + asset.currency
    detail += "\nPrior signed daily distances · " + period
    if not na(cutoff)
        detail += "\nAs of " + formatDay(cutoff)
    if na(snapshot)
        detail += "\nNo confirmed MA observation available."
    else
        if na(sharedCutoff) or cutoff != sharedCutoff
            detail += "\nSymbol's own confirmed date."
        detail += "\nClose " + formatDay(snapshot.day)
        if snapshot.priorCount > 0
            detail += "\n" + formatPeriod(snapshot.firstPriorDay, snapshot.lastPriorDay) + " · " + str.tostring(snapshot.priorCount, "#,##0") + " prior sessions"
        if na(snapshot.distance)
            detail += "\nA valid close and SMA are required."
        else if not snapshot.covered
            detail += "\nMore valid SMA history is needed for this period."
        else if na(snapshot.percentile)
            detail += "\nAt least " + str.tostring(MIN_MA_DISTANCES) + " prior sessions are required" + (math.sign(snapshot.distance) != 0 ? " on this side." : ".")
        else
            detail += "\nExtreme thresholds P" + str.tostring(maExtremePercentile) + " / P" + str.tostring(100 - maExtremePercentile) + "."
    if chartSymbol and comparisonUsesOwnPrices
        detail += "\nThe chart SMA follows the chart's price series."
    detail

maCell(table panel, int column, int row, string value, string detail, color extreme = na) =>
    color valueColor = value == MISSING_VALUE or value == "—" ? MUTED_COLOR : na(extreme) ? VALUE_COLOR : extreme
    table.cell(panel, column, row, value, text_color = valueColor, text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = detail)

renderComparison(table panel, array<ComparisonColumn> assets, int firstRow) =>
    var array<string> labels = array.from("CAGR", "1Y", "3Y", "5Y", "Current DD", "Max DD", "Max Dip", "Active Dip", "Dips ≥10%", "Dip Rarity", "MA Distance", "MA Percentile")
    [groups, comparableGroups] = opportunityGroups(assets, comparisonAnchor)
    if firstRow > 0
        // Leave space for TradingView's chart controls in the top-right corner.
        table.cell(panel, 0, 0, " ", text_size = size.small)
    table.cell(panel, 0, firstRow, compareCurrency, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = SECTION_BG)
    int opportunityRow = firstRow + 1
    int firstMetricRow = opportunityRow + 1
    table.cell(panel, 0, opportunityRow, "Opportunity", text_color = VALUE_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG, text_formatting = text.format_bold)
    for [row, label] in labels
        table.cell(panel, 0, firstMetricRow + row, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG)
    int priceRow = firstMetricRow + ROW_MA_PERCENTILE + 1
    table.cell(panel, 0, priceRow, "Price", text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG)
    for [index, asset] in assets
        int column = index + 1
        array<string> parts = str.split(asset.tickerId, ":")
        OpportunityGroup group = na(asset.currency) ? na : groups.get(asset.currency)
        ComparisonSnapshot snapshot = na
        if not na(group) and asset.lastDay >= group.cutoff and eligibleOpportunity(asset, comparisonAnchor)
            snapshot := opportunityForCutoff(asset, group.cutoff)
        bool isLeader = sharesOpportunityLead(group, snapshot, comparableGroups)
        string name = parts.last() + (isLeader ? " ★" : "")
        string headerDetail = asset.tickerId + (na(asset.currency) ? "" : " · " + asset.currency)
        headerDetail += "\nLatest confirmed: " + formatDay(asset.lastDay) + ".\nLoaded history: " + formatPeriod(asset.firstDay, asset.lastDay) + "."
        headerDetail += "\nPrice adjustments depend on the symbol's feed."
        if isLeader
            headerDetail += "\nHighest comparable Opportunity as of " + formatDay(group.cutoff) + "."
        table.cell(panel, column, firstRow, name, text_color = isLeader ? BEST_COLOR : VALUE_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = SECTION_BG, tooltip = headerDetail)
        bool ranked = not na(snapshot)
        ComparisonSnapshot displayed = ranked ? snapshot : not asset.missingFx ? opportunityForCutoff(asset, asset.lastDay) : na
        string score = na(displayed) ? MISSING_VALUE : formatOpportunity(displayed.score)
        color scoreInk = ranked ? opportunityColor(group, snapshot) : na(displayed) ? MUTED_COLOR : VALUE_COLOR
        table.cell(panel, column, opportunityRow, score, text_color = scoreInk, text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = opportunityDetail(asset, group, displayed, comparableGroups, ranked), text_formatting = text.format_bold)
        for [row, value] in asset.values
            string displayValue = row == ROW_DIPS ? dipFrequencyText(asset.dipCount, value, asset.yearsPerDip) : formatPercent(value)
            bool provisional = not na(asset.market) and (row == ROW_MAX_DD ? asset.market.developingMax : row == ROW_ACTIVE_DIP ? asset.market.developingActive : row == ROW_CURRENT_DD and asset.market.developing)
            string detail = comparisonDetail(asset, row)
            table.cell(panel, column, firstMetricRow + row, formatMarketValue(displayValue, provisional), text_color = comparisonColor(assets, asset, row), text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = detail)
        maCell(panel, column, priceRow, formatMarketPrice(asset.market), marketPriceDetail(asset.market) + (na(asset.currency) ? "" : "\n" + asset.currency))
        int rarityCutoff = not na(group) ? dipRarityCutoff(assets, asset.currency, group.cutoff, comparisonAnchor) : na
        ComparisonSnapshot rarity = comparisonForCutoff(asset, rarityCutoff)
        if not hasDipRarity(rarity)
            ComparisonSnapshot latest = comparisonForCutoff(asset, asset.lastDay)
            if hasDipRarity(latest)
                rarity := latest
                rarityCutoff := latest.cutoff
        bool validRarity = hasDipRarity(rarity)
        string rarityValue = validRarity ? formatDipRarity(rarity.rarityCount, rarity.rarityDays) : MISSING_VALUE
        string rarityDetail = dipRarityDetail(rarity, rarityCutoff, asset.missingFx)
        table.cell(panel, column, firstMetricRow + ROW_RARITY, rarityValue, text_color = validRarity ? VALUE_COLOR : MUTED_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = PANEL_BG, tooltip = rarityDetail)
        if index == 0 and rarityMarkVisible
            drawRarityDip(rarity, rarityDetail)
        int sharedMaCutoff = na(group) ? na : group.cutoff
        [ma, maCutoff] = maComparisonForCutoff(asset, sharedMaCutoff)
        string detail = maComparisonDetail(asset, ma, maCutoff, sharedMaCutoff, index == 0)
        float distance = na(ma) ? na : ma.distance
        string distanceText = (math.sign(distance) == 1 ? "+" : "") + formatPercent(distance)
        string percentileText = na(ma) or na(ma.percentile) ? MISSING_VALUE : "P" + str.tostring(ma.percentile, "0.0")
        color extreme = na(ma) or ma.extreme == 0 ? na : ma.extreme > 0 ? LOW_COLOR : BEST_COLOR
        maCell(panel, column, firstMetricRow + ROW_MA_DISTANCE, distanceText, detail, extreme)
        maCell(panel, column, firstMetricRow + ROW_MA_PERCENTILE, percentileText, detail, extreme)

formatMaDistance(float magnitude, bool above) =>
    na(magnitude) ? MISSING_VALUE : (above ? "+" : "−") + formatPercent(magnitude)

formatMaDuration(float length) =>
    na(length) ? MISSING_VALUE : str.tostring(length, length == int(length) ? "#,##0" : "#,##0.0")

renderMaBehavior(table panel, MaSummary history, int firstRow) =>
    var array<string> labels = array.from("Time %", "Median Distance", "P90 Distance", "Median Duration", "P90 Duration", "Current Duration", "Current Stretch")
    if firstRow > 0
        table.cell(panel, 0, 0, " ", text_size = size.small)
    table.cell(panel, 0, firstRow, "", bgcolor = SECTION_BG)
    for [index, label] in labels
        table.cell(panel, 0, firstRow + index + 1, label, text_color = LABEL_COLOR, text_halign = text.align_left, text_size = size.small, bgcolor = PANEL_BG)

    int total = history.above.sessions + history.below.sessions + history.equalCount
    string window = "\n" + formatPeriod(history.startDay, history.endDay) + "."
    if not history.covered
        window += " The selected calendar period needs more valid MA history."
    string timeDetail = str.tostring(total, "#,##0") + " comparable sessions including closes equal to MA. At least " + str.tostring(MIN_MA_SESSIONS) + " required." + window
    for column = 1 to 2
        bool above = column == 1
        table.cell(panel, column, firstRow, above ? "Above" : "Below", text_color = VALUE_COLOR, text_halign = text.align_right, text_size = size.small, bgcolor = SECTION_BG)
        MaSideSummary stats = above ? history.above : history.below
        bool current = history.side == (above ? 1 : -1)
        color extreme = above ? LOW_COLOR : BEST_COLOR
        string duration = current ? (history.runStartKnown ? "" : "≥") + formatMaDuration(history.runLength) : history.comparable ? "—" : MISSING_VALUE
        string distanceDetail = str.tostring(stats.sessions, "#,##0") + " sessions on this side. At least " + str.tostring(MIN_MA_DISTANCES) + " required." + window
        string runDetail = str.tostring(stats.runs, "#,##0") + " complete runs. At least " + str.tostring(MIN_MA_RUNS) + " required. Durations count trading sessions." + window
        string currentDetail = "Consecutive trading sessions on this side. ≥ marks an unobserved start."
        string stretchDetail = "Share of prior same-side distances no greater in magnitude than today's." + (current ? " Current distance: " + formatMaDistance(math.abs(history.distance), above) + "." : "") + "\nAt least " + str.tostring(MIN_MA_DISTANCES) + " prior sessions required." + window
        maCell(panel, column, firstRow + 1, formatPercent(history.covered and total >= MIN_MA_SESSIONS ? 100.0 * stats.sessions / total : na), timeDetail)
        maCell(panel, column, firstRow + 2, formatMaDistance(stats.medianDistance, above), distanceDetail)
        maCell(panel, column, firstRow + 3, formatMaDistance(stats.p90Distance, above), distanceDetail)
        maCell(panel, column, firstRow + 4, formatMaDuration(stats.medianDuration), runDetail)
        maCell(panel, column, firstRow + 5, formatMaDuration(stats.p90Duration), runDetail)
        maCell(panel, column, firstRow + 6, duration, currentDetail)
        maCell(panel, column, firstRow + 7, current ? formatPercent(history.stretch) : history.comparable ? "—" : MISSING_VALUE, stretchDetail, current and history.event != 0 ? extreme : na)

string panelPosition = switch panelCorner
    "Top left" => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left" => position.bottom_left
    => position.top_right

bool dipsPanel = supportedChart and showDips
int panelFirstRow = panelCorner == "Top right" ? 1 : 0
int panelRows = maBehaviorPanel ? 8 + panelFirstRow : not supportedChart ? 1 + panelFirstRow : comparisonPanel ? ROW_MA_PERCENTILE + 4 + panelFirstRow : dipsPanel ? (orderedThresholds ? 7 : 4) : 8
int panelColumns = comparisonPanel ? 2 + extraSymbols.size() : maBehaviorPanel ? 3 : dipsPanel ? 2 : 4
bool cellBackgrounds = comparisonPanel or maBehaviorPanel
var table panel = table.new(panelPosition, panelColumns, panelRows, bgcolor = cellBackgrounds ? na : PANEL_BG, frame_color = SECTION_BG, frame_width = cellBackgrounds ? 0 : 1)
if barstate.isfirst
    if dipsPanel
        if not orderedThresholds
            table.merge_cells(panel, 0, 3, 1, 3)
    else if not comparisonPanel and not maBehaviorPanel
        table.merge_cells(panel, 0, supportedChart ? 0 : panelFirstRow, supportedChart ? 1 : 3, supportedChart ? 0 : panelFirstRow)
        if supportedChart
            table.merge_cells(panel, 0, 6, 3, 6)

if barstate.islast
    int lastDay = chartPrices.lastDay
    float lastClose = chartPrices.lastClose
    int firstDay = chartPrices.firstDay
    if dipMarksVisible
        drawActiveDip(chartMarket)
    if swingMarksVisible
        PriceSegment leg = chartDips.rising ? swingSegment(chartDips.origin, chartDips.extreme) : chartMarket.activeLeg
        drawActiveSwing(leg, chartDips.rising, chartMarket.developingActive)
    if comparisonPanel
        renderComparison(panel, columns, panelFirstRow)
    else if maBehaviorPanel
        if not na(activeMa)
            renderMaBehavior(panel, activeMa.summary, panelFirstRow)
        else
            table.cell(panel, 0, panelFirstRow, "Daily history unavailable", bgcolor = PANEL_BG, text_color = MUTED_COLOR, text_size = size.small)
    else if dipsPanel
        metricText(panel, 0, 0, "Price", formatMarketPrice(chartMarket), marketPriceDetail(chartMarket))
        metricText(panel, 0, 1, "Active Dip", formatMarketValue(formatPercent(chartMarket.active), chartMarket.developingActive), activeDipDetail(chartMarket) + "\n" + marketPriceDetail(chartMarket))
        metric(panel, 0, 2, "Max Dip", segmentDepth(chartMarket.maxDipLeg), maxDipDetail(chartMarket))
        if orderedThresholds
            string coverage = formatPeriod(chartDips.firstValidDay, lastDay)
            coverage += useWicks ? " · Wicks" : " · Close"
            coverage += " · " + str.tostring(chartDips.observedDays, "#,##0") + " observed calendar days."
            if chartDips.invalidBars > 0
                coverage += "\n" + str.tostring(chartDips.invalidBars) + " invalid sessions · " + str.tostring(chartDips.interrupted) + " interrupted dips excluded."
            for [index, threshold] in thresholds
                dipMetric(panel, index + 3, threshold, chartDips.counts.get(index), chartDips.observedDays, chartDips.everReady ? chartDips.firstValidDay : na, coverage)
        else
            band(panel, 3, "Enter increasing dip thresholds")
    else if supportedChart
        float lastSma = barstate.isconfirmed ? smaForDay : smaForDay[1]

        float priceReturn = 100 * (priceRatio(chartPrices) - 1)
        float cagr = annualizedReturn(chartPrices)
        float smaDistance = changePercent(chartMarket.price, lastSma)
        float shareAbove = comparableDays > 0 ? 100.0 * aboveSmaDays / comparableDays : na

        string dateDetail = "First valid close to latest confirmed session in TradingView's loaded history."
        if not na(lastDay) and na(lastClose)
            dateDetail += " Latest confirmed close unavailable."
        band(panel, 0, formatPeriod(firstDay, lastDay), dateDetail)
        metricText(panel, 2, 0, "Price", formatMarketPrice(chartMarket), marketPriceDetail(chartMarket))
        metric(panel, 0, 1, "Return", priceReturn, "Price return since the first valid close. Adjustments follow the chart's price series.")
        metric(panel, 2, 1, "CAGR", cagr, "Annualized price return using elapsed calendar days.")
        periodMetric(panel, 0, 2, 1, lastDay, lastClose, chartPrices)
        periodMetric(panel, 2, 2, 3, lastDay, lastClose, chartPrices)
        periodMetric(panel, 0, 3, 5, lastDay, lastClose, chartPrices)
        periodMetric(panel, 2, 3, 10, lastDay, lastClose, chartPrices)
        string marketDetail = "\n" + marketPriceDetail(chartMarket)
        metricText(panel, 0, 4, "Current DD", formatMarketValue(formatPercent(chartMarket.currentDD), chartMarket.developing), currentDrawdownDetail() + marketDetail)
        metricText(panel, 2, 4, "Max DD", formatMarketValue(formatPercent(chartMarket.maxDD), chartMarket.developingMax), maxDrawdownDetail(chartMarket) + marketDetail)
        metricText(panel, 0, 5, "Active Dip", formatMarketValue(formatPercent(chartMarket.active), chartMarket.developingActive), activeDipDetail(chartMarket) + marketDetail)
        metric(panel, 2, 5, "Max Dip", segmentDepth(chartMarket.maxDipLeg), maxDipDetail(chartMarket))
        string unit = smaTimeframe == "Daily" ? "D" : smaTimeframe == "Weekly" ? "W" : "M"
        string maLabel = "SMA " + str.tostring(smaLength) + unit
        if smoothSma and smaTimeframe != "Daily"
            maLabel += " · Smooth"
        band(panel, 6, maLabel, "Uses consecutive valid closes on the selected timeframe. Weekly and monthly values become available in the next period.")
        metricText(panel, 0, 7, "MA Distance", formatMarketValue(formatPercent(smaDistance), chartMarket.developing), "Latest price relative to the available confirmed SMA." + marketDetail)
        metric(panel, 2, 7, "Above MA", shareAbove, str.tostring(comparableDays, "#,##0") + " comparable days. Closes equal to SMA are included in the denominator.")
    else
        string instruction = supportedMaChart ? "Use a 1D chart or select MA Behavior" : "Use a standard time-based chart"
        if panelFirstRow > 0
            table.cell(panel, 0, 0, " ", text_size = size.small)
        band(panel, panelFirstRow, instruction)
